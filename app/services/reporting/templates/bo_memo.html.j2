<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Business Overview - {{ memo.case.borrower or memo.case.case_id }}</title>
<style>
  body { font-family: Georgia, "Times New Roman", serif; color: #1c2430; max-width: 900px; margin: 2.2rem auto; padding: 0 1.4rem; line-height: 1.5; font-size: 15px; }
  h1 { font-size: 1.7rem; margin: 0 0 .2rem; }
  h2 { font-size: 1.15rem; margin: 2rem 0 .5rem; padding-bottom: .25rem; border-bottom: 2px solid #1c2430; }
  h3 { font-size: 1rem; margin: 1.1rem 0 .3rem; }
  .meta, .small { font-family: Arial, Helvetica, sans-serif; font-size: .8rem; color: #55606e; }
  .banner { font-family: Arial, Helvetica, sans-serif; font-size: .85rem; padding: .6rem .8rem; margin: .8rem 0; border-left: 4px solid #8a6d1c; background: #fbf6e6; }
  .banner.sim { border-color: #9a3324; background: #fbeeea; }
  .banner.block { border-color: #9a3324; background: #fbeeea; font-weight: bold; }
  .claim { margin: .55rem 0 .8rem; }
  .tag { font-family: Arial, Helvetica, sans-serif; font-size: .68rem; text-transform: uppercase; letter-spacing: .04em; padding: .08rem .4rem; border-radius: 3px; border: 1px solid #c3cad3; color: #404b59; margin-right: .3rem; white-space: nowrap; }
  .tag.positive { border-color: #2f6b45; color: #2f6b45; }
  .tag.negative { border-color: #9a3324; color: #9a3324; }
  .tag.mixed { border-color: #8a6d1c; color: #8a6d1c; }
  .qual { font-style: italic; color: #55606e; }
  sup a { text-decoration: none; color: #23527c; font-family: Arial, Helvetica, sans-serif; font-size: .7rem; }
  table { border-collapse: collapse; width: 100%; font-family: Arial, Helvetica, sans-serif; font-size: .8rem; margin: .5rem 0; }
  th, td { text-align: left; vertical-align: top; padding: .3rem .5rem; border-bottom: 1px solid #d9dee4; }
  th { background: #f1f3f6; }
  ul { margin: .3rem 0 .6rem 1.2rem; padding: 0; }
  .cols { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .cols > div { flex: 1 1 320px; }
  .notice { font-family: Arial, Helvetica, sans-serif; font-size: .8rem; color: #6b7480; }
  .src { word-break: break-word; }
  .module { margin: .8rem 0 0; padding: .2rem 0 0 .9rem; border-left: 3px solid #c3cad3; }
  .module h3 { font-size: .95rem; }
  .module h4 { font-family: Arial, Helvetica, sans-serif; font-size: .8rem; margin: .8rem 0 .2rem; text-transform: uppercase; letter-spacing: .04em; color: #404b59; }
  .tag.complete { border-color: #2f6b45; color: #2f6b45; }
  .tag.incomplete, .tag.fail { border-color: #9a3324; color: #9a3324; }
  .tag.pass { border-color: #2f6b45; color: #2f6b45; }
  .num { text-align: right; white-space: nowrap; }
  .tablewrap { overflow-x: auto; }
  .structure-diagram { text-align: center; margin: .6rem 0; page-break-inside: avoid; }
  .structure-diagram img { max-width: 100%; height: auto; }
  @page { size: A4; margin: 16mm 14mm; }
  @media print {
    body { max-width: none; margin: 0; padding: 0; font-size: 10.5pt; }
    table { font-size: 8pt; }
    th, td { overflow-wrap: break-word; padding: .25rem .35rem; }
    .num { white-space: normal; }
    tr { break-inside: avoid; }
    h2, h3, h4 { break-after: avoid; }
  }
</style>
</head>
<body>
{% macro cites(c) %}{% for n in c.citations %}<sup><a href="#src-{{ n }}">[{{ n }}]</a></sup>{% endfor %}{% endmacro %}
{% macro claim(c) %}
<div class="claim" id="claim-{{ c.claim_id }}">
  <span class="tag {{ c.signal }}">{{ c.signal }}</span>{% if c.claim_type %}<span class="tag">{{ c.claim_type|replace('_', ' ') }}</span>{% endif %}<span class="tag">{{ c.materiality }} materiality</span><br>
  {% if c.title %}<strong>{{ c.title }}.</strong> {% endif %}{{ c.text }}{{ cites(c) }}
  {% if c.uncertainty %}<div class="qual">Qualification: {{ c.uncertainty }}</div>{% endif %}
  {% for q in c.quoted_values %}<div class="small">Calculation: {{ q.label }} = {{ q.value }}{% if q.unit %} ({{ q.unit }}){% endif %}{% if q.denominator %}, denominator {{ q.denominator }}{% endif %}{% if q.period %}, period {{ q.period }}{% endif %}</div>{% endfor %}
</div>
{% endmacro %}
{% macro finding(f) %}
<div class="claim">
  <span class="tag {{ f.direction }}">{{ f.direction }}</span><span class="tag">{{ f.materiality }} materiality</span>{% if f.attributed %}<span class="tag">management claim</span>{% endif %}{% if f.disposition == 'qualified' %}<span class="tag mixed">qualified</span>{% endif %}<br>
  {{ f.text }}{{ cites(f) }}
  {% if f.mechanism %}<div class="small">Credit mechanism: {{ f.mechanism }}</div>{% endif %}
  {% set i = f.interpretation or {} %}
  {% if i.implication %}<div class="small">Why it matters: {{ i.implication }}</div>{% endif %}
  {% if i.magnitude %}<div class="small">Magnitude: {{ i.magnitude }}</div>{% endif %}
  {% if i.trend %}<div class="small">Trend: {{ i.trend }}</div>{% endif %}
  {% if i.watch_trigger %}<div class="small">Watch: {{ i.watch_trigger }}</div>{% endif %}
  {% for q in f.qualifications or [] %}<div class="qual">Qualification: {{ q }}</div>{% endfor %}
  {% for q in f.quotes or [] %}<div class="small">Filing: &ldquo;{{ q }}&rdquo;</div>{% endfor %}
</div>
{% endmacro %}
{% macro list_or_none(items, none_text='None recorded.') %}
{% if items %}<ul>{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul>{% else %}<p class="notice">{{ none_text }}</p>{% endif %}
{% endmacro %}
{% macro m3_panel(m) %}
<h4>Borrower identification</h4>
<p class="small">{{ m.borrower.status|replace('_', ' ') }}{% if m.borrower.legal_name %}: {{ m.borrower.legal_name }}{% endif %}{% if m.borrower.limitation %}. {{ m.borrower.limitation }}{% endif %}</p>
<h4>Legal entities</h4>
{% if m.legal_entities %}
<div class="tablewrap"><table><tr><th>Entity</th><th>Jurisdiction</th><th>Classification</th><th>Verification</th></tr>
{% for e in m.legal_entities %}<tr><td>{{ e.legal_name }}{{ cites(e) }}</td><td>{{ e.jurisdiction or '' }}</td><td>{{ (e.classification or '')|replace('_', ' ') }}</td><td>{{ e.verification_status }}</td></tr>{% endfor %}
</table></div>{% else %}<p class="notice">No legal entities were validated.</p>{% endif %}
{% if m.ownership %}
<h4>Ownership</h4>
<div class="tablewrap"><table><tr><th>Parent</th><th>Subsidiary</th><th>Ownership</th><th>Confirmation</th></tr>
{% for r in m.ownership %}<tr><td>{{ r.parent }}</td><td>{{ r.subsidiary }}</td><td class="num">{% if r.ownership_percentage is not none %}{{ r.ownership_percentage }}%{% else %}n/a{% endif %}</td><td>{{ r.confirmation_status }}</td></tr>{% endfor %}
</table></div>{% endif %}
<h4>Structural credit findings</h4>
{% for f in m.structural_findings %}{{ finding(f) }}{% else %}<p class="notice">No material structural finding was validated.</p>{% endfor %}
<h4>Senior management</h4>
{% for o in m.management %}
<div class="claim"><span class="tag {{ o.direction }}">{{ o.direction }}</span><span class="tag">{{ o.dimension|replace('_', ' ') }}</span><span class="tag">{{ o.materiality }} materiality</span>{% if o.attributed %}<span class="tag">management claim</span>{% endif %}<br>
<strong>{{ o.legal_name }}, {{ o.role }}.</strong> {{ o.text }}{{ cites(o) }}
{% if o.mechanism %}<div class="small">Credit mechanism: {{ o.mechanism }}</div>{% endif %}</div>
{% else %}<p class="notice">No material management observation was validated.</p>{% endfor %}
{% if m.governance_findings %}<h4>Governance screening</h4>{% for f in m.governance_findings %}{{ finding(f) }}{% endfor %}{% endif %}
<h4>Information gaps</h4>
{{ list_or_none(m.information_gaps) }}
{% endmacro %}
{% macro m3_v2_panel(m, diagram=none) %}
<h4>Corporate structure <span class="tag">{{ m.structure.status|replace('_', ' ') }}</span></h4>
{% if m.structure.status == 'complete' %}
<p class="small">{{ m.structure.company }}: {{ m.structure.entities }} entities in the submitted structure.</p>
{% if m.structure.disclaimer %}<p class="qual">{{ m.structure.disclaimer }}</p>{% endif %}
{% if diagram %}<div class="structure-diagram"><img src="{{ diagram.src }}" width="{{ diagram.width }}" height="{{ diagram.height }}" alt="Corporate structure diagram"></div>
{% elif m.structure.tree %}<pre class="small">{{ m.structure.tree }}</pre>{% endif %}
{% else %}<p class="notice">{{ m.structure.error or 'No corporate-structure input was supplied.' }}</p>{% endif %}
<h4>Senior management <span class="tag">{{ m.management.status|replace('_', ' ') }}</span></h4>
{% if m.management.source %}<p class="small">Source: {{ m.management.source }}</p>{% endif %}
{% if m.management.overall %}<p><span class="tag {{ m.management.outcome }}">{{ m.management.outcome }}</span> {{ m.management.overall }}</p>{% endif %}
{% for o in m.management.observations %}
<div class="claim"><span class="tag {{ o.direction }}">{{ o.direction }}</span><span class="tag">{{ o.category|replace('_', ' ') }}</span><br>
<strong>{{ o.executive or 'Information limitation' }}.</strong> {{ o.text }}
{% for q in o.quotes %}<div class="small">Filing: &ldquo;{{ q }}&rdquo;</div>{% endfor %}</div>
{% else %}<p class="notice">{{ m.management.error or 'No reviewed management observation is available.' }}</p>{% endfor %}
{% if m.management.profiles %}
<div class="tablewrap"><table><tr><th>Executive</th><th>Position</th><th>Appointed</th><th>Recency</th><th>Succession</th></tr>
{% for p in m.management.profiles %}<tr><td>{{ p.name }}</td><td>{{ p.position }}</td><td>{{ p.appointed }}</td><td>{{ p.recency|replace('_', ' ') }}</td><td>{{ p.succession|replace('_', ' ') }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% if m.management.limitations %}<h4>Management limitations</h4>{{ list_or_none(m.management.limitations) }}{% endif %}
{% endmacro %}
{% macro m4_panel(m) %}
{% if not m.debt_run %}
<p class="notice">The Module 4 debt-structure specialist was not run for this analysis, so debt structure, refinancing and debt utilisation are not assessed here. This section rests on the strategy and capital-allocation agent only.</p>
{% else %}
<p class="small">Debt-structure specialist: <span class="tag {{ 'pass' if m.debt_validated else 'fail' }}">{{ m.debt_status|replace('_', ' ') }}</span>{% if m.debt_reason %} {{ m.debt_reason }}{% endif %}{{ cites(m) }}</p>
{% if m.d4 %}
{% set box = m.d4.executive_credit_summary_box %}
<h4>Debt structure credit conclusion</h4>
<p><strong>{{ box.overall_credit_rating_verdict|replace('_', ' ') }}</strong> &middot; {{ box.target_entity_and_period }}</p>
{{ list_or_none(box.executive_takeaways, 'No takeaways recorded.') }}
<p>{{ m.d4.core_credit_assessment }}</p>
{% endif %}
{% if m.d1 %}
{% set cpf = m.d1.creditor_priority_framework %}
<h4>Debt and creditor priority</h4>
<div class="tablewrap"><table><tr><th>Tier</th><th class="num">$M</th></tr>
<tr><td>Tier 1: direct OpCo secured</td><td class="num">{{ cpf.tier_1_direct_opco_secured_m|money }}</td></tr>
<tr><td>Tier 2: senior unsecured, guaranteed</td><td class="num">{{ cpf.tier_2_senior_unsecured_guaranteed_m|money }}</td></tr>
<tr><td>Tier 3: unguaranteed HoldCo</td><td class="num">{{ cpf.tier_3_unguaranteed_holdco_m|money }}</td></tr>
<tr><th>Consolidated total indebtedness</th><th class="num">{{ cpf.consolidated_total_indebtedness_m|money }}</th></tr>
</table></div>
<p class="small">Structural subordination drag ratio {{ cpf.structural_subordination_drag_ratio }}. Prospective bank loan, if secured: {{ cpf.prospective_loan_secured_placement }} If senior unsecured: {{ cpf.prospective_loan_senior_unsecured_placement }}</p>
{% if m.d1.senior_notes_schedule %}
<div class="tablewrap"><table><tr><th>Senior notes</th><th>Borrower</th><th class="num">Principal $M</th><th>Coupon</th><th>Maturity</th><th>Security</th><th>Tier</th></tr>
{% for n in m.d1.senior_notes_schedule %}<tr><td>{{ n.senior_note_series }}</td><td>{{ n.legal_borrower }}</td><td class="num">{{ n.principal_amount_m|money }}</td><td>{{ n.coupon_interest_rate }}</td><td>{{ n.maturity_year }}</td><td>{{ n.collateral_security_status|replace('_', ' ') }}</td><td>{{ n.priority_ranking_tier|replace('_', ' ') }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% if m.d1.non_note_obligations_schedule %}
<div class="tablewrap"><table><tr><th>Other obligations</th><th>Borrower</th><th class="num">Drawn $M</th><th class="num">Limit $M</th><th>Terms</th><th>Maturity</th><th>Tier</th></tr>
{% for n in m.d1.non_note_obligations_schedule %}<tr><td>{{ n.obligation_facility }}</td><td>{{ n.legal_borrower }}</td><td class="num">{{ n.principal_drawn_m|money }}</td><td class="num">{{ n.available_facility_limit_m|money }}</td><td>{{ n.interest_rate_terms }}</td><td>{{ n.maturity }}</td><td>{{ n.priority_ranking_tier|replace('_', ' ') }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% if m.d1.reconciling_items %}
<div class="tablewrap"><table><tr><th>Reconciling item</th><th class="num">$M</th><th>As the filing states it</th></tr>
{% for r in m.d1.reconciling_items %}<tr><td>{{ r.label }}</td><td class="num">{{ r.amount_m|money }}</td><td>&ldquo;{{ r.quote }}&rdquo;</td></tr>{% endfor %}
</table></div>
<p class="small">Lines between the instruments and total indebtedness. Validator 8 counts each only when its quote appears verbatim in the filing and states its amount.</p>{% endif %}
{% endif %}
{% if m.d2 %}
<h4>Refinancing and maturity</h4>
<p>{{ m.d2.refinancing_capacity_discipline_verdict }}</p>
<p class="small">Weighted average refinancing lead time {{ m.d2.metrics.weighted_avg_refinancing_lead_time_months }} months &middot; refinancing cost delta {{ m.d2.metrics.refinancing_cost_spread_delta_bps }} bps &middot; weighted average maturity extension {{ m.d2.metrics.weighted_avg_maturity_extension_years }} years &middot; distress events {{ m.d2.metrics.historical_refinancing_distress_events }}</p>
{% if m.d2.refinancing_log %}
<div class="tablewrap"><table><tr><th>Transaction</th><th>Obligation</th><th class="num">$M</th><th>Terms</th><th>Date</th><th>Maturity</th><th>Use of proceeds</th></tr>
{% for r in m.d2.refinancing_log %}<tr><td>{{ r.transaction_category|replace('_', ' ') }}</td><td>{{ r.obligation_series_description }}</td><td class="num">{{ r.principal_amount_m|money }}</td><td>{{ r.coupon_interest_terms }}</td><td>{{ r.execution_date_fiscal_period }}</td><td>{{ r.original_retired_maturity or '' }}{% if r.new_extended_maturity %} &rarr; {{ r.new_extended_maturity }}{% endif %}</td><td>{{ r.use_of_proceeds_impact }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% endif %}
{% if m.d3 %}
<h4>Debt utilisation and leverage impact</h4>
<p>{{ m.d3.debt_utilisation_leverage_verdict }}</p>
<p class="small">{{ m.d3.debt_utilisation_matrix.debt_funded_vs_internally_funded_deployment }} {{ m.d3.debt_utilisation_matrix.shareholder_distributions_vs_leverage_balance }}</p>
{% if m.d3.capital_deployment_reconciliation %}
<div class="tablewrap"><table><tr><th>Capital stream</th><th>Use</th><th class="num">3-year $M</th><th>Funding source</th><th>Leverage impact</th></tr>
{% for c in m.d3.capital_deployment_reconciliation %}<tr><td>{{ c.capital_allocation_stream }}</td><td>{{ c.specific_use_description }}</td><td class="num">{{ c.cumulative_amount_3y_m|money }}</td><td>{{ c.primary_funding_source }}</td><td>{{ c.leverage_impact }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% endif %}
{% if m.d4 and m.d4.synthesis_matrix %}
<h4>Synthesis matrix</h4>
<div class="tablewrap"><table><tr><th>Scope</th><th>Evidence</th><th>Verdict</th><th>Lender implication</th></tr>
{% for r in m.d4.synthesis_matrix %}<tr><td>{{ r.analytical_scope_pillar }}</td><td>{{ r.core_empirical_evidence }}</td><td>{{ r.deliverable_verdict }}</td><td>{{ r.bank_lender_implications }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% if m.checks %}
<h4>Debt-structure validator</h4>
<div class="tablewrap"><table><tr><th>Check</th><th>Result</th><th>Detail</th></tr>
{% for c in m.checks %}<tr><td>{{ c.name or c.check_id }}</td><td><span class="tag {{ 'pass' if c.passed else 'fail' }}">{{ 'pass' if c.passed else 'fail' }}</span></td><td>{{ c.detail }}</td></tr>{% endfor %}
</table></div>{% endif %}
{% if m.missing_information %}<h4>Module 4 limitations</h4>{{ list_or_none(m.missing_information) }}{% endif %}
{% endif %}
{% endmacro %}
{% macro module_panel(mod) %}
<div class="module" id="module-{{ mod.code }}">
<h3>{{ mod.code }} governed module output <span class="tag {{ mod.status }}">{{ mod.status }}</span></h3>
{% if mod.failed_or_missing_agents %}<p class="small">Specialists not validated: {{ mod.failed_or_missing_agents|join(', ') }}.</p>{% endif %}
{% if mod.unresolved_coverage_checks %}<p class="small">Unresolved coverage checks: {{ mod.unresolved_coverage_checks|join(', ') }}.</p>{% endif %}
{% if mod.m3_v2 %}{{ m3_v2_panel(mod.m3_v2, m3_structure_image) }}{% elif mod.m3 %}{{ m3_panel(mod.m3) }}{% elif mod.code == 'M3' %}<p class="notice">The validated M3 corporate-structure and management assessment is unavailable for this run.</p>{% endif %}
{% if mod.m4 %}{{ m4_panel(mod.m4) }}{% endif %}
{% if mod.further_findings %}
<h4>Further governed specialist findings</h4>
<p class="small">Accepted, material findings from this module's specialists that the narrative above does not rest on.</p>
{% for f in mod.further_findings %}{{ finding(f) }}{% endfor %}
{% endif %}
{% if mod.missing_information %}<h4>Information not available</h4>{{ list_or_none(mod.missing_information) }}{% endif %}
</div>
{% endmacro %}

<h1>Business Overview</h1>
<div class="meta">
  {{ memo.case.borrower or memo.case.case_id }} &middot; case {{ memo.case.case_id }} &middot; as of {{ memo.case.as_of_date }} &middot; evidence cut-off {{ memo.case.evidence_cutoff }} &middot; evidence snapshot v{{ memo.case.evidence_snapshot_version }}<br>
  Analysis run {{ memo.run.analysis_run_id }} &middot; registry {{ memo.run.agent_registry_version }} &middot; scope: Business Overview only
</div>
{% if memo.run.execution_mode == 'offline_simulation' %}<div class="banner sim">{{ memo.run.execution_label }}</div>{% endif %}
{% if memo.run.validators_enforced is sameas false %}<div class="banner block">Validators off: an ungoverned draft. The BO validators ran in advisory mode, so findings they would have qualified, held back or rejected appear as the agents wrote them. Their notes are in the audit report.</div>{% endif %}
<div class="banner{% if memo.status.conclusion_status in ['human_review_required', 'unavailable'] %} block{% endif %}">
  Status: {{ memo.status.conclusion_status|replace('_', ' ') }}. {{ memo.status.text }}
  Human review: {{ memo.status.human_review_status }}.
</div>

<h2>Executive Business Credit Assessment</h2>
{% if memo.executive.provisional_view %}
<h3>Provisional business credit view</h3>
{{ claim(memo.executive.provisional_view) }}
<div class="cols">
  <div><h3>Material business strengths</h3>
    {% if memo.executive.strengths %}<ul>{% for s in memo.executive.strengths %}<li><a href="#claim-{{ s.claim_id }}">{{ s.title }}</a></li>{% endfor %}</ul>{% else %}<p class="notice">None selected.</p>{% endif %}</div>
  <div><h3>Material business weaknesses</h3>
    {% if memo.executive.weaknesses %}<ul>{% for s in memo.executive.weaknesses %}<li><a href="#claim-{{ s.claim_id }}">{{ s.title }}</a></li>{% endfor %}</ul>{% else %}<p class="notice">None selected.</p>{% endif %}</div>
</div>
<h3>Principal uncertainties</h3>
{% if memo.executive.principal_uncertainties %}<ul>{% for u in memo.executive.principal_uncertainties %}<li>{{ u }}</li>{% endfor %}</ul>{% else %}<p class="notice">None recorded.</p>{% endif %}
<h3>Required follow-up</h3>
{% if memo.executive.follow_up %}<ul>{% for u in memo.executive.follow_up %}<li>{{ u }}</li>{% endfor %}</ul>{% else %}<p class="notice">None recorded.</p>{% endif %}
{% else %}
<p class="notice">No validated Business conclusion is available for this run.</p>
{% endif %}

{% for s in memo.sections %}
<h2>{{ s.title }}</h2>
{% for c in s.claims %}{{ claim(c) }}{% endfor %}
{% if s.headline_refs %}<p class="notice">Headline finding{{ 's' if s.headline_refs|length > 1 }} set out under Key Credit Strengths and Vulnerabilities: {% for r in s.headline_refs %}<a href="#claim-{{ r.claim_id }}">{{ r.title }}</a>{{ '; ' if not loop.last }}{% endfor %}.</p>{% endif %}
{% if s.further_findings %}
<h3>Further validated findings</h3>
<p class="small">Accepted, material findings from this section's specialist that the narrative above does not rest on.</p>
{% for f in s.further_findings %}{{ finding(f) }}{% endfor %}
{% elif s.notice %}<p class="notice">{{ s.notice }}</p>{% endif %}
{% if s.module %}{{ module_panel(s.module) }}{% endif %}
{% endfor %}

<h2>Key Credit Strengths and Vulnerabilities</h2>
<div class="cols">
  <div><h3>Strengths</h3>{% for c in memo.strengths_vulnerabilities.strengths %}{{ claim(c) }}{% else %}<p class="notice">None selected.</p>{% endfor %}</div>
  <div><h3>Vulnerabilities</h3>{% for c in memo.strengths_vulnerabilities.weaknesses %}{{ claim(c) }}{% else %}<p class="notice">None selected.</p>{% endfor %}</div>
</div>

<h2>Outstanding Questions / Data Limitations</h2>
{% set o = memo.outstanding %}
{% for title, items in [('Open questions', o.open_questions), ('Unresolved contradictions', o.unresolved_contradictions), ('Information not available in the admitted evidence', o.missing_information), ('Coverage and retrieval limitations', o.data_limitations)] %}
<h3>{{ title }}</h3>
{% if items %}<ul>{% for i in items %}<li>{{ i }}</li>{% endfor %}</ul>{% else %}<p class="notice">None recorded.</p>{% endif %}
{% endfor %}
<h3>Unresolved challenger findings</h3>
{% if o.unresolved_challenges %}
<table><tr><th>Severity</th><th>Issue</th><th>Finding</th><th>Claim</th></tr>
{% for f in o.unresolved_challenges %}<tr><td>{{ f.severity }}</td><td>{{ f.issue_type|replace('_', ' ') }}</td><td>{{ f.reason }}</td><td>{{ f.target or '' }}</td></tr>{% endfor %}
</table>{% else %}<p class="notice">None. Challenger outcome: {{ memo.status.challenge|replace('_', ' ') }}.</p>{% endif %}

{% if memo.calculations %}
<h2>Deterministic Calculations Referenced</h2>
<table><tr><th>Indicator</th><th>Value</th><th>Unit</th><th>Period</th><th>Numerator</th><th>Denominator</th><th>Formula</th><th>State</th></tr>
{% for c in memo.calculations %}<tr><td>{{ c.label }}{% if c.caveat %}<br><span class="qual">{{ c.caveat }}</span>{% endif %}</td><td>{{ c.value }}</td><td>{{ c.units }}</td><td>{{ c.period }}</td><td>{{ c.numerator.name if c.numerator else '' }}</td><td>{{ c.denominator.name if c.denominator else 'n/a' }}</td><td>{{ c.formula_id }}</td><td>{{ c.calculation_state }}</td></tr>{% endfor %}
</table>
{% endif %}

<h2>Evidence Cited</h2>
{% if memo.sources %}
<table><tr><th>#</th><th>Source</th><th>Location</th><th>Excerpt</th></tr>
{% for s in memo.sources %}<tr id="src-{{ s.n }}"><td>{{ s.n }}</td><td class="src">{{ s.form or '' }} {{ s.filename or '' }}<br>{{ s.sec_accession or '' }}<br><span class="small">{{ s.evidence_id[:16] }}</span></td><td>{{ s.section or '' }}{% if s.location is not none %}, offset {{ s.location }}{% endif %}{% if s.page %}, p.{{ s.page }}{% endif %}</td><td>{{ s.excerpt }}&hellip;</td></tr>{% endfor %}
</table>{% else %}<p class="notice">No evidence is cited.</p>{% endif %}
<p class="small">Generated {{ memo.run.completed_at }} &middot; {{ memo.document }} {{ memo.version }}. Rendered from the memo JSON; the accompanying audit report records every agent execution, hypothesis and validation.</p>
</body>
</html>
