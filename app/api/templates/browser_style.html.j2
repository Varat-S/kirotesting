<style>
  :root { color-scheme: light; font-family: system-ui, sans-serif; color: #22334a; background: #f3f6fa; }
  * { box-sizing: border-box; }
  body { max-width: 1200px; margin: 0 auto; padding: 32px 24px; line-height: 1.55; }
  h1, h2, h3 { line-height: 1.2; } h1 { margin-bottom: 12px; }
  a { color: #155cb7; } a:hover { color: #093264; }
  header, main > section, .workbench-counts, nav { background: white; border: 1px solid #dce4ee; border-radius: 12px; padding: 24px; margin-bottom: 20px; }
  .subtle { color: #5b6c80; } .notice { background: #fff8e5; border-left: 4px solid #d49b25; padding: 14px 18px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .actions a { display: inline-block; border: 1px solid #c8d7e9; border-radius: 6px; padding: 7px 12px; text-decoration: none; }
  .badge { display: inline-block; background: #eef3fb; padding: 2px 10px; border-radius: 20px; font-size: .9rem; }
  dl { display: grid; grid-template-columns: minmax(130px, 180px) 1fr; gap: 6px 16px; } dt { color: #5b6c80; } dd { margin: 0; overflow-wrap: anywhere; }
  nav ul { display: flex; flex-wrap: wrap; gap: 10px 22px; list-style: none; padding: 0; }
  .table-wrap { overflow-x: auto; } table { width: 100%; border-collapse: collapse; font-size: .93rem; }
  th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #e7ecf2; vertical-align: top; } th { color: #56687e; background: #f8fafd; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; background: #f8fafd; padding: 16px; max-height: 500px; overflow-y: auto; font-size: .82rem; }
  details { margin-top: 14px; } summary { cursor: pointer; color: #155cb7; } section { scroll-margin-top: 20px; }
  @media (max-width: 650px) { body { padding: 16px 12px; } header, main > section, nav { padding: 18px; } dl { grid-template-columns: 1fr; } }
</style>
