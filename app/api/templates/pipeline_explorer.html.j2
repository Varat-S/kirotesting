<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Pipeline Explorer</title>
<style>
  :root {
    --bg:#0f1720; --panel:#16202b; --ink:#e6edf3; --muted:#9fb0c0;
    --line:#2b3b4b; --accent:#4fa3ff;
    --validated:#1b7a3d; --qualified:#b8860b; --incomplete:#8a6d1a;
    --failed:#b3261e; --skipped:#5f6368; --absent:#394657; --error:#7a1fa2;
  }
  * { box-sizing:border-box; }
  body { margin:0; font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
         background:var(--bg); color:var(--ink); }
  header { padding:10px 16px; border-bottom:1px solid var(--line);
           display:flex; gap:14px; align-items:center; flex-wrap:wrap; }
  header h1 { font-size:16px; margin:0; }
  select, button { background:var(--panel); color:var(--ink);
    border:1px solid var(--line); border-radius:6px; padding:6px 10px; font-size:13px; }
  button { cursor:pointer; }
  button:hover { border-color:var(--accent); }
  .layout { display:flex; height:calc(100vh - 54px); }
  .graphwrap { position:relative; flex:1; overflow:hidden; background:
      radial-gradient(circle at 20px 20px, #1b2733 1px, transparent 1px) 0 0/28px 28px; }
  svg { width:100%; height:100%; cursor:grab; }
  svg.panning { cursor:grabbing; }
  .inspector { width:420px; border-left:1px solid var(--line); background:var(--panel);
    overflow:auto; padding:0; display:flex; flex-direction:column; }
  .inspector .pad { padding:14px 16px; }
  .inspector h2 { font-size:15px; margin:0 0 4px; }
  .inspector h3 { font-size:12px; text-transform:uppercase; letter-spacing:.04em;
    color:var(--muted); margin:16px 0 6px; border-bottom:1px solid var(--line); padding-bottom:4px; }
  .kv { display:grid; grid-template-columns:140px 1fr; gap:4px 10px; font-size:13px; }
  .kv div:nth-child(odd) { color:var(--muted); }
  .pill { display:inline-block; padding:2px 9px; border-radius:999px; font-size:12px;
    font-weight:600; color:#fff; }
  .legend { display:flex; gap:12px; flex-wrap:wrap; font-size:12px; color:var(--muted);
    padding:8px 16px; border-top:1px solid var(--line); }
  .legend span.dot { display:inline-block; width:11px; height:11px; border-radius:3px;
    margin-right:5px; vertical-align:-1px; }
  .node rect { stroke:#0008; stroke-width:1; rx:7; }
  .node text { fill:#fff; font-size:11px; pointer-events:none; }
  .node.illustration rect { stroke-dasharray:4 3; }
  .node { cursor:pointer; }
  .node:hover rect { stroke:var(--accent); stroke-width:2; }
  .node.selected rect { stroke:var(--accent); stroke-width:3; }
  .edge { stroke:#54657a; stroke-width:1.4; fill:none; marker-end:url(#arrow); }
  .edge.optional { stroke-dasharray:5 4; stroke:#6b7f94; }
  .layerlabel { fill:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.05em; }
  pre.raw { background:#0b1118; border:1px solid var(--line); border-radius:6px;
    padding:10px; overflow:auto; max-height:320px; font-size:12px; white-space:pre-wrap; word-break:break-word; }
  .json-viewer { font-size:12.5px; }
  .json-viewer details { margin:2px 0 2px 8px; border-left:1px solid var(--line); padding-left:8px; }
  .json-viewer summary { cursor:pointer; color:var(--accent); font-weight:600; }
  .json-viewer .jv-row { display:flex; gap:8px; padding:1px 0; }
  .json-viewer .jv-key { color:var(--muted); min-width:120px; }
  .json-viewer .jv-val { color:var(--ink); word-break:break-word; }
  .json-viewer .jv-idx { color:#6b7f94; }
  .json-viewer .jv-count { color:var(--muted); font-weight:400; }
  .json-viewer .null { color:#7a8794; font-style:italic; }
  .json-viewer table.jv-table { border-collapse:collapse; margin:4px 0; width:100%; }
  .json-viewer table.jv-table th, .json-viewer table.jv-table td {
    border:1px solid var(--line); padding:3px 6px; text-align:left; vertical-align:top; }
  .json-viewer table.jv-table th { color:var(--muted); background:#0b1118; }
  .actions { display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
  .actions a { text-decoration:none; }
  .empty { color:var(--muted); padding:30px 16px; text-align:center; }
  .note { font-size:12px; color:var(--muted); margin-top:6px; }
</style>
</head>
<body>
<header>
  <h1>Pipeline Explorer</h1>
  <label>Case
    <select id="caseSelect">
      <option value="">— select a case —</option>
      {% for c in cases %}
        <option value="{{ c.case_id }}">{{ c.label }}{% if c.kind == 'demo_fixture' %} (fixture){% endif %}</option>
      {% endfor %}
    </select>
  </label>
  <button id="btnFit">Fit to screen</button>
  <button id="btnZoomIn">+</button>
  <button id="btnZoomOut">−</button>
  <button id="btnManifest">Open manifest JSON</button>
  <span id="caseNote" class="note"></span>
</header>

<div class="layout">
  <div class="graphwrap">
    <svg id="graph" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid meet">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7"
                markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="#54657a"></path>
        </marker>
      </defs>
      <g id="viewport"></g>
    </svg>
  </div>
  <aside class="inspector">
    <div class="pad" id="inspectorBody">
      <div class="empty">Select a case, then click any agent, validator or output node to inspect its recorded output.</div>
    </div>
  </aside>
</div>

<div class="legend" id="legend"></div>

<script>
const STATUS_COLORS = {
  validated:'#1b7a3d', qualified:'#b8860b', incomplete:'#8a6d1a',
  failed:'#b3261e', skipped:'#5f6368', absent:'#394657', error:'#7a1fa2'
};
const STATUS_LABEL = {
  validated:'Produced & validated', qualified:'Accepted w/ qualification',
  incomplete:'Partial / incomplete', failed:'Failed / rejected',
  skipped:'Skipped', absent:'No recorded output', error:'Unreadable artifact'
};

const svg = document.getElementById('graph');
const viewport = document.getElementById('viewport');
let view = {x:0, y:0, k:1};
let currentCase = '';
let currentGraph = null;

function renderLegend() {
  const el = document.getElementById('legend');
  el.innerHTML = Object.entries(STATUS_LABEL).map(([k,v]) =>
    `<span><span class="dot" style="background:${STATUS_COLORS[k]}"></span>${v}</span>`).join('');
}
renderLegend();

const LAYER_W = 250, LAYER_GAP = 40, NODE_W = 200, NODE_H = 40, V_GAP = 14, TOP = 60;

function layout(graph) {
  const byLayer = {};
  graph.nodes.forEach(n => { (byLayer[n.layer] = byLayer[n.layer] || []).push(n); });
  const pos = {};
  let maxY = 0;
  Object.keys(byLayer).map(Number).sort((a,b)=>a-b).forEach(layer => {
    const col = byLayer[layer];
    const x = 30 + layer * (LAYER_W + LAYER_GAP);
    col.forEach((n, i) => {
      const y = TOP + i * (NODE_H + V_GAP);
      pos[n.id] = {x, y};
      maxY = Math.max(maxY, y + NODE_H);
    });
  });
  return {pos, maxY, byLayer};
}

function draw(graph) {
  currentGraph = graph;
  viewport.innerHTML = '';
  const {pos, maxY, byLayer} = layout(graph);

  // Layer labels
  Object.entries(graph.layers).forEach(([layer, name]) => {
    const x = 30 + Number(layer) * (LAYER_W + LAYER_GAP);
    const t = document.createElementNS('http://www.w3.org/2000/svg','text');
    t.setAttribute('x', x); t.setAttribute('y', 30);
    t.setAttribute('class','layerlabel'); t.textContent = name;
    viewport.appendChild(t);
  });

  // Edges
  graph.edges.forEach(e => {
    const a = pos[e.source], b = pos[e.target];
    if (!a || !b) return;
    const p = document.createElementNS('http://www.w3.org/2000/svg','path');
    const x1 = a.x + NODE_W, y1 = a.y + NODE_H/2, x2 = b.x, y2 = b.y + NODE_H/2;
    const mx = (x1 + x2) / 2;
    p.setAttribute('d', `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2}`);
    p.setAttribute('class', 'edge' + (e.reason && e.reason.startsWith('optional') ? ' optional' : ''));
    viewport.appendChild(p);
  });

  // Nodes
  graph.nodes.forEach(n => {
    const p = pos[n.id];
    const g = document.createElementNS('http://www.w3.org/2000/svg','g');
    g.setAttribute('class', 'node' + (n.illustration ? ' illustration':''));
    g.setAttribute('transform', `translate(${p.x},${p.y})`);
    g.dataset.id = n.id;
    const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
    rect.setAttribute('width', NODE_W); rect.setAttribute('height', NODE_H);
    rect.setAttribute('rx', 7);
    rect.setAttribute('fill', STATUS_COLORS[n.status] || '#394657');
    g.appendChild(rect);
    const label = (n.label.length > 30 ? n.label.slice(0,29)+'…' : n.label);
    const t = document.createElementNS('http://www.w3.org/2000/svg','text');
    t.setAttribute('x', 10); t.setAttribute('y', 17); t.textContent = label;
    g.appendChild(t);
    const t2 = document.createElementNS('http://www.w3.org/2000/svg','text');
    t2.setAttribute('x', 10); t2.setAttribute('y', 31);
    t2.setAttribute('style','font-size:9px;fill:#cdd9e5');
    t2.textContent = n.kind + (n.illustration ? ' · illustration' : '');
    g.appendChild(t2);
    g.addEventListener('click', () => selectNode(n));
    viewport.appendChild(g);
  });

  fit(maxY, byLayer);
}

function applyView() {
  viewport.setAttribute('transform', `translate(${view.x},${view.y}) scale(${view.k})`);
}
function fit(maxY, byLayer) {
  const layers = Object.keys(byLayer).length;
  const w = 60 + layers * (LAYER_W + LAYER_GAP);
  const h = (maxY || 900) + 60;
  svg.setAttribute('viewBox', `0 0 ${Math.max(w,1600)} ${Math.max(h,900)}`);
  view = {x:0, y:0, k:1}; applyView();
}

// Pan & zoom
let dragging = false, last = null;
svg.addEventListener('mousedown', e => { dragging = true; last = {x:e.clientX,y:e.clientY}; svg.classList.add('panning'); });
window.addEventListener('mouseup', () => { dragging = false; svg.classList.remove('panning'); });
window.addEventListener('mousemove', e => {
  if (!dragging) return;
  view.x += (e.clientX - last.x); view.y += (e.clientY - last.y);
  last = {x:e.clientX,y:e.clientY}; applyView();
});
svg.addEventListener('wheel', e => {
  e.preventDefault();
  const f = e.deltaY < 0 ? 1.12 : 0.89;
  view.k = Math.min(3, Math.max(0.3, view.k * f)); applyView();
}, {passive:false});
document.getElementById('btnZoomIn').onclick = () => { view.k = Math.min(3, view.k*1.15); applyView(); };
document.getElementById('btnZoomOut').onclick = () => { view.k = Math.max(0.3, view.k*0.85); applyView(); };
document.getElementById('btnFit').onclick = () => { if (currentGraph) draw(currentGraph); };
document.getElementById('btnManifest').onclick = () => {
  if (currentCase) window.open(`/pipeline/${encodeURIComponent(currentCase)}/manifest.json`, '_blank');
};

function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

async function selectNode(n) {
  document.querySelectorAll('.node').forEach(el => el.classList.toggle('selected', el.dataset.id === n.id));
  const body = document.getElementById('inspectorBody');
  if (!n.artifact_id || n.status === 'absent') {
    body.innerHTML = `<h2>${esc(n.label)}</h2>
      <div class="kv"><div>Kind</div><div>${esc(n.kind)}</div>
      <div>Status</div><div><span class="pill" style="background:${STATUS_COLORS[n.status]}">${esc(STATUS_LABEL[n.status]||n.status)}</span></div></div>
      <p class="note">${n.illustration ? 'Illustration node — fixed pipeline scaffolding, not a recorded execution.' : (n.status_reason || 'No recorded artifact for this node in the selected case.')}</p>`;
    return;
  }
  body.innerHTML = '<div class="empty">Loading…</div>';
  try {
    const r = await fetch(`/pipeline/${encodeURIComponent(currentCase)}/node/${encodeURIComponent(n.artifact_id)}`);
    if (!r.ok) { body.innerHTML = `<div class="empty">${esc((await r.json()).detail)}</div>`; return; }
    const info = await r.json();
    const vr = await fetch(`/pipeline/${encodeURIComponent(currentCase)}/node/${encodeURIComponent(n.artifact_id)}/view.html`);
    const viewerHtml = vr.ok ? await vr.text() : '';
    const base = `/pipeline/${encodeURIComponent(currentCase)}/node/${encodeURIComponent(n.artifact_id)}`;
    const prod = info.producer || {};
    body.innerHTML = `
      <h2>${esc(info.artifact_id)}</h2>
      <div class="kv">
        <div>Type</div><div>${esc(info.artifact_type)}</div>
        <div>Status</div><div><span class="pill" style="background:${STATUS_COLORS[info.status]}">${esc(STATUS_LABEL[info.status]||info.status)}</span></div>
        <div>Producer module</div><div>${esc(prod.module)}</div>
        <div>Producer agent</div><div>${esc(prod.agent)}</div>
        <div>Validator</div><div>${esc(prod.validator)}</div>
        <div>Run id</div><div>${esc(info.run_id)}</div>
        <div>Schema</div><div>${esc(info.schema_name)}</div>
        <div>Evidence snapshot</div><div>${esc(info.source_evidence_snapshot)}</div>
        <div>Depends on</div><div>${esc((info.depends_on||[]).join(', '))}</div>
        <div>Validation</div><div>${esc(info.validation_status)}</div>
        <div>Human review</div><div>${esc(info.human_review_status)}</div>
        <div>Model</div><div>${esc(info.model_id)} ${info.model_invoked===false?'(not invoked)':''}</div>
        <div>Prompt version</div><div>${esc(info.prompt_version)}</div>
        <div>Content hash</div><div style="word-break:break-all">${esc(info.content_hash)}</div>
      </div>
      <div class="actions">
        <a href="${base}/download.json" target="_blank"><button>Download JSON</button></a>
        <a href="${base}/export.pdf" target="_blank"><button>Render PDF</button></a>
      </div>
      <h3>Evidence IDs</h3>
      <div>${(info.evidence_ids||[]).length ? esc(info.evidence_ids.join(', ')) : '<span class="note">none referenced</span>'}</div>
      <h3>Parsed output</h3>
      ${viewerHtml || '<span class="note">no viewer</span>'}
      <h3>Raw JSON</h3>
      <pre class="raw">${esc(JSON.stringify(info.payload, null, 2))}</pre>`;
  } catch (e) {
    body.innerHTML = `<div class="empty">Error loading node: ${esc(e.message)}</div>`;
  }
}

async function loadCase(caseId) {
  currentCase = caseId;
  const note = (document.querySelector('#caseSelect option:checked') || {}).dataset || {};
  if (!caseId) {
    viewport.innerHTML = '';
    document.getElementById('inspectorBody').innerHTML =
      '<div class="empty">Select a case to render its pipeline.</div>';
    document.getElementById('caseNote').textContent = '';
    return;
  }
  const r = await fetch(`/pipeline/${encodeURIComponent(caseId)}/graph.json`);
  const graph = await r.json();
  draw(graph);
  document.getElementById('inspectorBody').innerHTML =
    '<div class="empty">Click any node to inspect its recorded output.</div>';
}

const sel = document.getElementById('caseSelect');
const notes = {
  {% for c in cases %}'{{ c.case_id }}': {{ (c.note or '') | tojson }},{% endfor %}
};
sel.addEventListener('change', () => {
  loadCase(sel.value);
  document.getElementById('caseNote').textContent = notes[sel.value] || '';
});
</script>
</body>
</html>
