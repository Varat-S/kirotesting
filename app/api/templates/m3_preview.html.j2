<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Module 3 · {{ case_id }}</title>{% include 'browser_style.html.j2' %}
<style>
body{max-width:1440px}.metrics{display:flex;flex-wrap:wrap;gap:12px}.metrics div{background:#f3f6fa;padding:12px 18px;border-radius:8px;min-width:130px}.metrics strong{display:block;font-size:1.5rem}.finding{border:1px solid #dce4ee;border-left:5px solid #8799ad;border-radius:8px;padding:20px;margin:18px 0}.qualified{border-left-color:#b38422}.accepted{border-left-color:#258369}.rejected{border-left-color:#b34d4d}.chain{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px}.chain h4{color:#56687e;margin:14px 0 8px}.chart{width:100%;height:auto;border:1px solid #e7ecf2}.quote{border-left:3px solid #c8d7e9;padding-left:12px;white-space:pre-wrap}.reference{font: .75rem ui-monospace,monospace;overflow-wrap:anywhere}.pill{font-size:.82rem;text-transform:uppercase;font-weight:600}.executive{border-top:1px solid #e7ecf2;padding:18px 0} @media(max-width:850px){.chain{grid-template-columns:1fr}}
</style></head><body>
{% macro values(items) %}{% if items %}<ul>{% for item in items %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<span class="subtle">Not established in saved results.</span>{% endif %}{% endmacro %}
{% macro citations(items) %}{% for s in items %}<details><summary>Evidence {{ s.evidence_id or s.source.evidence_id }}</summary>{% set source=s.source or s %}<p class="reference">{{ source.evidence_id }} · {{ source.filename or '' }} {{ source.section or '' }}</p>{% if source.quotation_kind %}<p class="subtle">{{ source.quotation_kind }} · Citation exists: {{ source.citation_exists }} · Literal quotation matches: {{ source.quoted_text_matches_source }}</p>{% endif %}<blockquote class="quote">{{ source.quote or s.value or 'No quotation retained for this citation.' }}</blockquote></details>{% endfor %}{% endmacro %}
<header><span class="badge">Saved standalone Module 3 · Read only</span><h1>Corporate structure & senior management</h1><p class="reference">{{ case_id }}</p><p class="subtle">HCA Healthcare · FY2025 Form 10-K · Human review required</p><dl><dt>Analysis run</dt><dd>{{ manifest.analysis_run_id }}</dd><dt>Model</dt><dd>{{ stages.model_id or 'Not recorded' }}</dd><dt>Execution</dt><dd>{{ stages.model_execution or 'Unknown' }}</dd><dt>Assessment version</dt><dd>{{ review.assessment_version or 'Not recorded in browser review' }}</dd><dt>Management contract</dt><dd>{{ review.management_version or 'Not returned' }}</dd></dl><p>Refreshing this page reads saved files only. It cannot request a new model analysis.</p></header>
<nav><ul><li><a href="#structure">Ownership diagram</a></li><li><a href="#approved">Approved analysis</a></li><li><a href="#management">Senior management</a></li><li><a href="#proposals">All AI proposals</a></li><li><a href="#validation">Validation & gaps</a></li></ul></nav>
<main>
{% if stages.module_completion and stages.module_completion.startswith('failed_') %}<section class="notice"><h2>Analysis did not complete successfully</h2><p>{{ stages.module_completion }} · {{ validation.specialist_failure or stages.assessment_failure or '' }}</p><p>The chart below comes from the supplied structure. No offline sample or fallback analysis has been substituted.</p></section>{% endif %}
<section id="structure"><h2>Corporate ownership diagram</h2><p class="pill">Deterministic structure facts · supplied onboarding JSON</p>{% if simulation %}<p class="notice"><strong>Simulated structure — not verified HCA legal entities.</strong> The supplied entities, ownership stakes, hypothetical borrower and guarantor markings are authoritative assumptions within this lending exercise. They are not verified actual HCA facts or proof of legally enforceable guarantees.</p>{% endif %}{% if structure_available %}<a href="/m3/{{ case_id }}/structure.svg"><img class="chart" src="/m3/{{ case_id }}/structure.svg" alt="Saved corporate ownership diagram with entity names, ownership links and illustrative guarantor markings"></a>{% else %}<p>No validated corporate-structure diagram is available.</p>{% endif %}<details><summary>Deterministic observations and limitations</summary>{{ values(analysis.structural_limitations) }}<pre>{{ analysis.structural_observations | tojson(indent=2) }}</pre></details></section>
<section id="approved"><h2>Validator-approved credit analysis</h2><p class="subtle">Only admitted findings appear in this section. Qualified findings retain their caveats. All original proposals and rejected items are shown separately below.</p>{% if analysis.scenario_assumptions %}<p class="notice"><strong>Hypothetical-case credit analysis.</strong> {{ analysis.scenario_assumptions.scope }} Real-world verification: {{ analysis.scenario_assumptions.real_world_verification }}.</p>{% endif %}<h3>Corporate-structure credit findings</h3>{% for f in analysis.ai_structural_credit_findings or [] %}{% if f.finding_id in (analysis.admitted_structural_credit_finding_ids or []) %}<article class="finding {{ 'qualified' if f.disposition=='qualified' else 'accepted' }}"><span class="badge">{{ f.disposition }} · {{ f.credit_direction }}</span><h3>{{ f.finding_id }} · {{ f.analytical_dimension }}</h3><div class="chain"><div><h4>Evidence / structural observation</h4><p>{{ f.structural_observation }}</p></div><div><h4>AI inference</h4><p>{{ f.credit_hypothesis }}</p></div><div><h4>Credit implication</h4><p>{{ f.causal_mechanism }}</p></div></div>{{ values(f.qualifications) }}<details><summary>References and validation</summary><pre>{{ f | tojson(indent=2) }}</pre></details></article>{% endif %}{% endfor %}{% if not analysis.admitted_structural_credit_finding_ids %}<p>No AI structural-credit finding was admitted.</p>{% endif %}
<h3>Senior-management credit findings</h3>{% for f in management.credit_findings or [] %}<article class="finding {{ 'qualified' if f.disposition=='qualified' else 'accepted' }}"><span class="badge">{{ f.disposition }} · {{ f.credit_direction }}</span><h3>{{ f.finding_id }}</h3><div class="chain"><div><h4>Evidence</h4>{% for e in f.evidence %}<p>{{ e.kind }}: {{ e.value }} {{ e.date or '' }}</p>{% endfor %}</div><div><h4>AI inference</h4><p>{{ f.qualified_inference }}</p></div><div><h4>Credit implication</h4><p>{{ f.credit_implication }}</p></div></div>{{ citations(f.evidence) }}<h4>Qualifications and counterevidence</h4>{{ values(f.uncertainties) }}{{ values(f.mitigating_considerations) }}</article>{% else %}<p>No management-stability credit finding was admitted.</p>{% endfor %}</section>
<section id="management"><h2>Senior-management stability & continuity</h2>{% set overall=management.consolidated_management_stability_conclusion or {} %}<p class="badge">{{ overall.classification or management.assessment_status or 'Unavailable' }} · {{ overall.credit_direction or 'Direction not established' }}</p><p>{{ overall.summary or 'No validated management-stability conclusion is available.' }}</p><p class="subtle">The overall conclusion is derived from admitted findings. Company familiarity and tenure do not establish competence or integrity.</p>{% set scope=management.overall_management_stability_assessment or {} %}<p>Review date: {{ scope.as_of_date or 'Not established' }} · Change window: {{ scope.recent_change_window_years or 'Not established' }} years · History coverage: {{ scope.history_coverage or 'Not established' }}</p>{% if stages.canonical_schema_validation=='rejected' %}<p class="notice">Source evidence reached Gemini. Its response failed validation, so no management conclusion or profile was admitted.</p>{% else %}{{ values(overall.limitations or management.limitations) }}{% endif %}
{% if scope.executive_roster_coverage %}{% set coverage=scope.executive_roster_coverage %}<p>Disclosed roster coverage: <strong>{{ coverage.status }}</strong> · {{ coverage.verified_count }} verified / {{ coverage.expected_count }} expected.</p>{% if coverage.omitted_names %}<p class="notice">Omitted disclosed executives: {{ coverage.omitted_names | join(', ') }}</p>{% endif %}{% endif %}<h3>Key executives</h3>{% for e in management.key_executive_details or [] %}<article class="executive"><h3>{{ e.name }} <small>· {{ e.current_role }}</small></h3><span class="badge">Profile {{ e.profile_status }} · {{ e.transition_type }}</span><dl><dt>Appointment</dt><dd>{{ e.appointment_date or 'Not verified' }}</dd><dt>Current-role tenure</dt><dd>{% if e.current_role_tenure.min_completed_months is defined %}{{ e.current_role_tenure.min_completed_months }}–{{ e.current_role_tenure.max_completed_months }} completed months, as of {{ e.current_role_tenure.as_of_date }}{% else %}Not verified{% endif %}</dd><dt>Prior HCA experience</dt><dd>{{ e.prior_company_experience }}</dd><dt>Recent appointment</dt><dd>{{ e.recent_appointment }}</dd></dl><div class="chain"><div><h4>Previous internal positions</h4>{{ values(e.previous_company_roles) }}</div><div><h4>External experience</h4>{{ values(e.external_roles) }}</div><div><h4>Profile limitations</h4>{{ values(e.limitations) }}</div></div>{{ citations(e.source_references) }}</article>{% else %}<p>No validated executive profiles are available. Any original model proposals remain separately labelled below.</p>{% endfor %}
{% if review.executives_proposed %}<h3>Actual Gemini executive proposals — unvalidated</h3><p class="notice">These are the original model proposals. Use the governed profiles above for evidence-verification outcomes. A syntactically valid fact or citation is not evidence approval.</p><div class="table-wrap"><table><thead><tr><th>Executive / position</th><th>Proposed facts</th><th>Model-proposed experience / transition</th></tr></thead><tbody>{% for e in review.executives_proposed %}<tr><td><strong>{{ e.name }}</strong><br>{{ e.current_role }}</td><td><pre>{{ e.facts | tojson(indent=2) }}</pre></td><td>{{ e.prior_company_experience }}<br>{{ e.transition_type }}<br>Recent appointment: {{ e.recent_appointment }}</td></tr>{% endfor %}</tbody></table></div>{% set proposed=review.management_review_proposed or {} %}<p>Model-proposed review date: <strong>{{ proposed.as_of_date }}</strong></p><p>Model-proposed scope: {{ proposed.review_scope }}</p>{% if proposed.as_of_source %}<p>Its cited date passage:</p><blockquote class="quote">{{ proposed.as_of_source.quote }}</blockquote>{% endif %}{{ values(proposed.limitations) }}{% endif %}
<h3>Recent senior-management changes</h3>{% for e in management.key_executive_details or [] if e.recent_appointment=='yes' %}<p><strong>{{ e.name }}</strong> · {{ e.current_role }} · {{ e.appointment_date }} · {{ e.transition_type }} · prior company experience: {{ e.prior_company_experience }}</p>{% else %}<p>No recent appointment was verified in the saved results. This does not establish that no changes occurred.</p>{% endfor %}</section>
<section id="proposals"><h2>AI-proposed findings and actual validation status</h2><p class="notice">A citation ID is not proof of a claim. Rejected and unverified proposals below are audit material and must not be treated as approved credit conclusions.</p><div class="metrics">{% for status,count in counts.items() %}<div><strong>{{ count }}</strong>{{ status }}</div>{% endfor %}</div>{% for f in review.proposals or [] %}<article class="finding {{ f.status }}"><span class="badge">{{ f.status }} · {{ f.kind }} · {{ f.credit_direction or 'Direction unavailable' }}</span><h3>{{ f.id }}</h3><div class="chain"><div><h4>Proposed evidence / observation</h4><p>{{ f.evidence }}</p></div><div><h4>AI-proposed inference</h4><p>{{ f.inference }}</p></div><div><h4>Proposed credit implication</h4><p>{{ f.credit_implication }}</p></div></div><p>Model-proposed disposition: {{ f.proposed_disposition }} · Validator disposition: {{ f.validator_disposition or 'Not admitted' }}</p>{{ citations(f.citations) }}<h4>Validation reasons and limitations</h4>{{ values(f.validation_reasons) }}{{ values(f.qualifications) }}</article>{% else %}<p>No original AI proposals are available in the saved browser review. No sample findings are substituted.</p>{% endfor %}{% if review.executives_proposed %}<details><summary>Original proposed executive profiles — not automatically validated</summary><pre>{{ review.executives_proposed | tojson(indent=2) }}</pre></details>{% endif %}</section>
<section><h2>Other original model classifications — not admitted</h2><p class="subtle">The status column below is Gemini's proposal, not a validator decision.</p><div class="table-wrap"><table><thead><tr><th>Parameter</th><th>Proposed value</th><th>Proposed status</th></tr></thead><tbody>{% for p in review.parameters_proposed or [] %}<tr><td>{{ p.parameter_id }}</td><td>{{ p.value if p.value is not none else 'Unavailable' }}</td><td>{{ p.status }}</td></tr>{% endfor %}</tbody></table></div>{% for h in review.hypotheses_proposed or [] %}<details><summary>{{ h.id }} · AI-proposed {{ h.proposed_disposition }} · {{ h.direction }}</summary><p>{{ h.claim }}</p>{{ citations(h.citations) }}</details>{% endfor %}</section>
<section id="validation"><h2>Validation & diagnostics</h2><dl><dt>Provider / HTTP</dt><dd>{{ stages.provider or 'Not recorded' }} / {{ review.http_status or stages.http_status or 'Not recorded' }}</dd><dt>Finish reason</dt><dd>{{ review.finish_reasons or 'Not recorded' }}</dd><dt>JSON parsing</dt><dd>{{ stages.json_parsing or 'Not run' }}</dd><dt>Generation draft</dt><dd>{{ stages.generation_draft_validation or 'Legacy contract' }}</dd><dt>Canonical input / assembly</dt><dd>{{ stages.canonical_input_validation or 'Not applicable to legacy contract' }}</dd><dt>{{ 'Canonical governed result' if stages.canonical_validation_target else 'Canonical schema' }}</dt><dd>{{ stages.canonical_schema_validation or 'Not run' }}</dd><dt>Specialist evidence gate</dt><dd>{{ stages.specialist_validation or 'Not run' }}</dd><dt>Validator 7</dt><dd>{{ stages.assessment_governance or 'Not run' }}</dd><dt>Module completion</dt><dd>{{ stages.module_completion or 'Not recorded' }}</dd><dt>Tokens</dt><dd>{{ stages.input_tokens or 'Not reported' }} input / {{ stages.output_tokens or 'Not reported' }} output</dd></dl><h3>Evidence gaps and unsupported claims</h3>{{ values(analysis.information_gaps) }}{% if stages.assessment_governance=='not_run' %}<p class="notice">Validator 7 did not run. Empty issue and rejection lists do not mean that the proposed findings passed.</p>{% endif %}<details open><summary>Validator issues</summary><pre>{{ validation.validation_issues | tojson(indent=2) }}</pre></details><details><summary>Rejected items</summary><pre>{{ validation.rejected_items | tojson(indent=2) }}</pre></details><details><summary>Execution and validation stages</summary><pre>{{ stages | tojson(indent=2) }}</pre></details><h3>Saved output files</h3><div class="actions">{% for name in files %}<a href="/m3/{{ case_id }}/artifacts/{{ name }}">{{ name }}</a>{% endfor %}</div><p class="subtle">Private model recordings, credentials and internal request bundles are not served by this preview.</p></section>
</main></body></html>
