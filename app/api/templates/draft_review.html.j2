<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Draft review</title>{% include 'browser_style.html.j2' %}</head><body>
<header><span class="badge">{{ 'Finalized' if draft.finalized else 'Draft' }}</span><h1>Credit memo review</h1><p>{{ draft.case_id }} · Draft {{ draft.snapshot_version }} · Evidence {{ draft.payload.evidence_snapshot_ref.snapshot_version }}</p><a href="/inspect/{{ draft.case_id }}/{{ draft.payload.evidence_snapshot_ref.snapshot_version }}">Review evidence and exceptions</a> · <a href="/cases/{{ draft.case_id }}/workbench.html">Case workbench</a></header>
<main><section><h2>Analysis and challenges</h2><pre>{{ draft.payload.business_analysis | tojson(indent=2) }}</pre><h3>Recommendation</h3><pre>{{ draft.payload.recommendation | tojson(indent=2) }}</pre><details><summary>All draft contents, calculations and provenance</summary><pre>{{ draft.payload | tojson(indent=2) }}</pre></details></section>
<section><h2>Outstanding exceptions</h2>{% for item in exceptions %}<p class="notice">{{ item.reason }} · {{ 'mandatory' if item.mandatory else 'optional' }}</p>{% else %}<p>No open exceptions.</p>{% endfor %}</section>
<section><h2>Approval and finalization</h2>{% if draft.finalized %}<p>Finalized with SHA-256 {{ draft.content_hash }}.</p>{% else %}<p>Review this exact draft before signing. Finalization requires a matching recorded approval and resolution of every mandatory exception.</p>
{% for action in ['approve','finalize'] %}<form method="post" action="/inspect/{{ draft.case_id }}/drafts/{{ draft.snapshot_version }}/{{ action }}"><fieldset><legend>{{ action | capitalize }} draft {{ draft.snapshot_version }}</legend><label>Your name<input name="reviewer" required maxlength="120"></label><label>Reason<input name="reason" required maxlength="2000"></label><label><input type="checkbox" name="confirmed" value="yes" required> I explicitly {{ action }} this draft.</label><button type="submit">{{ action | capitalize }}</button></fieldset></form>{% endfor %}{% endif %}</section>
<section><h2>Review history</h2>{% for review in reviews %}<details><summary>{{ review.action }} · {{ review.reviewer }} · {{ review.reason }}</summary><pre>{{ {'before':review.prior_value,'after':review.new_value,'review_id':review.review_id} | tojson(indent=2) }}</pre></details>{% else %}<p>No recorded reviews.</p>{% endfor %}</section></main></body></html>
