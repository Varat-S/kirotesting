<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Financial Overview workbench</title>{% include 'browser_style.html.j2' %}
<style>
  .ok { color: #2f6b45; font-weight: bold; } .bad { color: #9a3324; font-weight: bold; } .warn { color: #8a6d1c; font-weight: bold; }
  form.run { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 12px; align-items: end; }
  form.review { display: grid; grid-template-columns: 1fr 2fr; gap: 12px; align-items: end; }
  form.review .buttons { grid-column: 1 / -1; display: flex; gap: 10px; flex-wrap: wrap; }
  @media (max-width: 650px) { form.run, form.review { grid-template-columns: 1fr; } }
  .fo-progress { margin-top: 14px; padding: 12px 14px; border: 1px solid #c9d1da; border-radius: 6px; background: #f8fafd; }
  .fo-progress[hidden] { display: none; }
  .fo-progress .track { position: relative; height: 8px; border-radius: 4px; background: #e3e8ee; overflow: hidden; margin: 8px 0; }
  .fo-progress .bar { position: absolute; top: 0; left: -40%; width: 40%; height: 100%; border-radius: 4px; background: #2f6fb0; animation: fo-slide 1.4s ease-in-out infinite; }
  @keyframes fo-slide { from { left: -40%; } to { left: 100%; } }
  @media (prefers-reduced-motion: reduce) { .fo-progress .bar { animation: none; left: 0; width: 100%; opacity: .5; } }
</style></head>
<body>
{% macro st(v) %}<span class="{{ 'ok' if v in ['completed', 'accepted', 'continued', 'pass', 'compliant', 'routine', 'overridden', 'none', 'no_adjustment', 'Engine score', 'Overridden by analyst', 'not_applicable', 'billed_revenue'] else 'bad' if v in ['failed', 'rejected', 'stopped', 'fail', 'escalated', 'breach', 'unresolved'] else 'warn' }}">{{ (v or '—')|replace('_', ' ') }}</span>{% endmacro %}
<header><span class="badge">Financial Overview only</span><h1>Financial Overview workbench</h1>
<p class="subtle">Financial scorecard from a 10-K's Inline XBRL. The pre-checks run first (going concern; covenants: breach, waiver or relief amendment; acquisitions and divestitures: DSO and Debt/EBITDAR adjusted for the year's deals; prepaid model: DSO on billed revenue or at a reduced weight; always interpreted by the Pre-check Agent), then facts are collected, ratios computed and scored 1–10, and combined into a composite risk score. Every number is computed by code; the agent only classifies the filing's passages, and its quotes are verified. Unresolved pre-checks are escalated to an analyst.</p>
<div class="actions"><a href="/">All cases</a><a href="/fo">All Financial Overview runs</a><a href="/bo">Business Overview runs</a></div></header>
<main>
{% if error %}<section><p class="notice"><strong>Run failed.</strong> {{ error }}</p></section>{% endif %}
{% if stopped %}<section><p class="notice" id="fo-stopped"><strong>Run stopped.</strong> {{ stopped }} Model calls already made are still logged (and billed); no run was recorded.</p></section>{% endif %}

<section id="run"><h2>Run a Financial Overview</h2>
{% if filings %}
<form class="run" id="fo-run-form" method="post" action="/fo/run">
<input type="hidden" name="run_token" id="fo-run-token" value="{{ run_token }}">
<div><label for="folder">Filing folder in <code>edgar_filings/</code></label>
<select id="folder" name="folder" required>{% for f in filings %}<option value="{{ f.name }}"{% if f.name == selected_folder %} selected{% endif %}{% if not (f.has_instance and f.has_schema) %} disabled{% endif %}>{{ f.name }} ({{ f.files }} files{% if not (f.has_instance and f.has_schema) %}; no .htm/.xsd{% endif %})</option>{% endfor %}</select></div>
<div><label for="case_id">Case id <small>(optional)</small></label><input id="case_id" name="case_id" placeholder="e.g. HCA_FY2025" value="{{ case_id or '' }}"></div>
<div>{% if agent_ok %}<label for="model">Pre-check Agent model</label><select id="model" name="model">{% for m in models %}<option value="{{ m }}"{% if m == selected_model %} selected{% endif %}>{{ m }}</option>{% endfor %}</select>{% else %}<span class="subtle">Pre-check Agent model</span><br><strong class="bad">Pre-check Agent not configured</strong>{% endif %}</div>
<div><button class="primary-button" id="fo-run-button" type="submit"{% if not agent_ok %} disabled{% endif %}>Run</button></div>
</form>
<div class="fo-progress" id="fo-progress" role="status" aria-live="polite" hidden>
<strong>Running the Financial Overview…</strong> <span class="subtle" id="fo-progress-time">0 s</span>
<div class="track" aria-hidden="true"><div class="bar"></div></div>
<span class="subtle" id="fo-progress-detail">Reading the filing, then the Pre-check Agent (up to four model calls on <code id="fo-progress-model"></code>), then the measures. This usually takes 10–30 seconds; keep this page open.</span>
<div style="margin-top:8px"><button type="button" id="fo-stop-button">Stop the analysis</button> <span class="subtle" id="fo-stop-note">Stops at the next step; a model call already under way finishes first. Nothing is recorded.</span></div>
</div>
<script>
(function () {
  var form = document.getElementById("fo-run-form");
  if (!form) return;
  var box = document.getElementById("fo-progress"), timer = null;
  form.addEventListener("submit", function () {
    var button = document.getElementById("fo-run-button"), model = document.getElementById("model");
    document.getElementById("fo-progress-model").textContent = model ? model.value : "the configured model";
    box.hidden = false;
    if (button) { button.disabled = true; button.textContent = "Running…"; }
    var start = Date.now(), time = document.getElementById("fo-progress-time");
    timer = setInterval(function () { time.textContent = Math.round((Date.now() - start) / 1000) + " s"; }, 1000);
  });
  var stop = document.getElementById("fo-stop-button");
  stop.addEventListener("click", function () {
    stop.disabled = true;
    stop.textContent = "Stopping…";
    document.getElementById("fo-stop-note").textContent = "Stop requested: the run ends after the current step.";
    var body = new FormData();
    body.append("run_token", document.getElementById("fo-run-token").value);
    fetch("/fo/run/cancel", {method: "POST", body: body}).catch(function () {
      stop.disabled = false;
      stop.textContent = "Stop the analysis";
      document.getElementById("fo-stop-note").textContent = "Couldn't reach the server to stop the run; try again.";
    });
  });
  // Coming back with the browser's Back button: the run is over, so reset the form.
  window.addEventListener("pageshow", function () {
    if (timer) clearInterval(timer);
    box.hidden = true;
    var button = document.getElementById("fo-run-button");
    if (button && button.textContent === "Running…") { button.disabled = false; button.textContent = "Run"; }
    stop.disabled = false;
    stop.textContent = "Stop the analysis";
  });
})();
</script>
{% if agent_ok %}<p class="subtle">Models: the text-analysis models your Vertex key can use (checked with a free token count, refreshed every few hours); the default is <code>VERTEX_MODEL_NARROW</code> in <code>.env</code>. The pick applies to this run's four pre-checks only.{% if models_note %} <span class="warn">{{ models_note }}</span>{% endif %}</p>{% endif %}
<p class="subtle">Leave the case id empty to use TICKER_FY&lt;year&gt; from the filing's cover page. Each run is recorded; earlier runs are kept. The Pre-check Agent always interprets the pre-checks: it reads the auditor's report for going concern, every covenant search hit, and the deal notes; the keyword rules only cross-check it.{% if not agent_ok %} <span class="bad">A run needs a live provider in <code>.env</code> (as BO's <code>--live</code>): {{ agent_reason }}</span>{% else %} Model cost per run: one going-concern call, one covenant call when the search hits, one acquisitions-and-divestitures call when a deal note or mention is found, and one prepaid-model call (Item 1 and the revenue note).{% endif %}</p>
{% else %}
<p>No filing folders found. Create <code>edgar_filings/</code> in the project root and add one sub-folder per 10-K holding its Inline XBRL files (the <code>.htm</code> document, <code>.xsd</code> schema and <code>_lab</code> / <code>_pre</code> / <code>_cal</code> linkbases), e.g. <code>edgar_filings/HCA 10-K FY2025/</code>.</p>
{% endif %}
<p class="subtle">Command line: <code>python -m app.cli run-fo-case [CASE_ID] --filing "HCA 10-K FY2025" --live</code> (or <code>--responses agent.json</code> offline)</p>
</section>

<section id="runs"><h2>Recorded runs</h2>
{% if runs %}
<div class="table-wrap"><table><thead><tr><th>Case</th><th>Company</th><th>Period end</th><th>Going concern</th><th>Covenants</th><th>Acquisitions</th><th>Prepaid model</th><th>Composite</th><th>Rating</th><th>Model</th><th>Run</th><th>Started</th><th>Status</th><th>Open</th></tr></thead><tbody>
{% for r in runs %}<tr{% if view and r.run_id == view.run_id %} style="background:#eef3f8"{% endif %}><td>{{ r.case_id }}</td><td>{{ r.entity_name or r.filing_folder }}</td><td>{{ r.period_end or '' }}</td><td>{{ st(r.going_concern) if r.going_concern else '—' }}</td><td>{{ st(r.covenants) if r.covenants else '—' }}</td><td>{{ st(r.acquisitions) if r.acquisitions else '—' }}</td><td>{{ st(r.prepaid) if r.prepaid else '—' }}</td><td>{% if r.run_status == 'stopped' %}Not scored: going-concern fail{% elif r.run_status == 'awaiting_review' %}Awaiting decision{% else %}{{ r.composite_score if r.composite_score is not none else '—' }}{% endif %}</td><td>{{ r.credit_rating or '—' }}</td><td>{% if r.agent_model %}<code>{{ r.agent_model }}</code>{% else %}—{% endif %}</td><td><code>{{ r.run_id }}</code></td><td>{{ r.started_at }}</td><td>{{ st(r.run_status) }}</td><td><a href="/cases/{{ r.case_id }}/fo.html?run_id={{ r.run_id }}">Inspect</a></td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p>No Financial Overview run has been recorded yet.</p>{% endif %}
</section>

{% if view %}
{% set base = '/cases/' ~ view.case_id ~ '/fo/runs/' ~ view.run_id %}
{% set o = view.overview %}
<section id="filing"><h2>{{ o.meta.entity_name or view.filing_folder }} &mdash; run {{ view.run_id }}</h2>
<dl>
<dt>Case</dt><dd>{{ view.case_id }}</dd>
<dt>Filing</dt><dd>{{ o.meta.document_type or '10-K' }}, period ending {{ o.meta.period_end or 'unknown' }} (fiscal year {{ o.meta.fiscal_year or '?' }}){% if o.meta.ticker %} · {{ o.meta.ticker }}{% endif %}{% if o.meta.cik %} · CIK {{ o.meta.cik }}{% endif %}</dd>
<dt>Folder</dt><dd><code>edgar_filings/{{ o.filing.folder }}</code> · signature <code>{{ o.filing.signature[:16] }}</code></dd>
<dt>Files used</dt><dd>{% for k, v in o.filing.files.items() %}{{ k }}: <code>{{ v }}</code>{{ ' · ' if not loop.last }}{% endfor %}</dd>
<dt>Evidence</dt><dd>{{ o.filing.fact_count }} facts · {{ o.filing.context_count }} contexts · {{ o.filing.section_count }} presentation sections · {{ o.filing.working_capital_lines }} working-capital lines in the calculation linkbase</dd>
<dt>Industry group</dt><dd>{% if o.industry.industry_group %}{{ o.industry.industry_group }} (matched by {{ o.industry.matched_by }} to {{ o.industry.ticker }} in {{ o.industry.mapping_file }}){% else %}Not classified. {{ o.industry.note }}{% endif %}</dd>
<dt>Pre-check Agent model</dt><dd>{% if view.agent_model %}<code>{{ view.agent_model }}</code>{% else %}<span class="subtle">not recorded</span>{% endif %}</dd>
<dt>Engine</dt><dd>{{ o.engine_version }} · reference data <code>{{ o.reference_hash[:16] }}</code> · run hash <code>{{ view.content_hash[:16] }}</code> {% if view.integrity_ok %}<span class="ok">verified</span>{% else %}<span class="bad">does not match the recorded payload</span>{% endif %}</dd>
<dt>Run status</dt><dd>{{ st(view.run_status) }}</dd>
<dt>Human review</dt><dd>{{ st(view.human_review_status) }}{% if view.review %} · {{ view.review.decision }} by {{ view.review.reviewer }} on {{ view.review.decided_at[:16]|replace('T', ' ') }}: {{ view.review.reason }}{% endif %}{% for ov in view.overrides %} · {{ ov.measure }}: {{ 'override to ' ~ ov.analyst_score if ov.decision == 'override' else 'engine score accepted' }} by {{ ov.reviewer }} on {{ ov.decided_at[:16]|replace('T', ' ') }}: {{ ov.reason }}{% endfor %}{% if view.human_review_status == 'pending' %} <span class="subtle">(nothing was escalated: no going-concern fail, no covenant breach and no unresolved deal)</span>{% endif %}</dd>
</dl>
{% set pending_override = o.gate.pending if o.gate.state in ['awaiting_override', 'awaiting_gc_decision'] else [] %}
{% if o.gate.state == 'awaiting_gc_decision' %}
<div id="review" class="fo-gate" style="border-left:4px solid #EF4444;background:#fdf1f0;padding:12px 16px;border-radius:6px">
<h3>Analyst decision required: going concern (agent and verified evidence disagree)</h3>
<p>{{ o.gate.gc_decision.reason }}. The agent's FAIL quote did not hold up against the filing (see "Held back" in the going-concern pre-check below), so the engine scored the run on the verified result. Read the agent's answer and the passages, then decide. <strong>Use the verified result</strong>: the run is scored as calculated (any measure still escalated below waits for its own decision). <strong>Continue</strong> or <strong>Stop</strong>: side with the agent's FAIL (continue: overall score 10, measures superseded; stop: "Not scored: going-concern fail"). The decision is recorded once and cannot be changed.</p>
<form class="review" method="post" action="{{ base }}/review">
<div><label for="reviewer">Reviewer</label><input id="reviewer" name="reviewer" required></div>
<div><label for="reason">Reason</label><input id="reason" name="reason" required placeholder="Why"></div>
<div class="buttons"><button class="primary-button" type="submit" name="decision" value="use_verified">Use the verified result ({{ o.gate.gc_decision.verified|upper }})</button><button type="submit" name="decision" value="continue">Fail: continue at score 10</button><button type="submit" name="decision" value="stop">Fail: stop the analysis</button></div>
</form>
<p class="subtle">Command line: <code>python -m app.cli fo-review {{ view.run_id }} --decision use_verified|continue|stop --reviewer "&lt;name&gt;" --reason "&lt;why&gt;"</code></p>
</div>
{% endif %}
{% for e in pending_override %}
<div id="override-{{ e.measure }}" class="fo-gate" style="border-left:4px solid #EF4444;background:#fdf1f0;padding:12px 16px;border-radius:6px">
<h3>Analyst decision required: {{ e.measure_name }} ({{ e.title or 'covenant breach' }})</h3>
<p>{{ e.reason }}. {{ e.detail or 'The engine set revolver availability to 0 and the score to 10.' }} Engine score: <strong>{{ e.engine_score if e.engine_score is not none else 'none' }}</strong>{% if e.calculated_score is not none %} (calculated before the adjustment: {{ e.calculated_score }}){% endif %}. Read the {{ {'acquisitions': 'acquisitions-and-divestitures', 'prepaid': 'prepaid-model'}.get(e.check, 'covenant') }} pre-check below, then accept the engine's score or enter your own (1–10). The composite is re-weighted on the score you record. The decision is recorded once and cannot be changed.</p>
<form class="review" method="post" action="{{ base }}/override">
<input type="hidden" name="measure" value="{{ e.measure }}">
<div><label for="reviewer-{{ e.measure }}">Reviewer</label><input id="reviewer-{{ e.measure }}" name="reviewer" required></div>
<div><label for="reason-{{ e.measure }}">Reason</label><input id="reason-{{ e.measure }}" name="reason" required placeholder="Why this score"></div>
<div><label for="score-{{ e.measure }}">Your score (1–10, for an override)</label><input id="score-{{ e.measure }}" name="score" type="number" min="1" max="10" step="0.1"></div>
<div class="buttons"><button class="primary-button" type="submit" name="decision" value="accept">Accept the engine's score ({{ e.engine_score }})</button><button type="submit" name="decision" value="override">Override with my score</button></div>
</form>
<p class="subtle">Command line: <code>python -m app.cli fo-override {{ view.run_id }} --measure {{ e.measure }} --decision accept|override [--score N] --reviewer "&lt;name&gt;" --reason "&lt;why&gt;"</code></p>
</div>
{% endfor %}
{% if o.gate.state == 'awaiting_review' %}
<div id="review" class="fo-gate" style="border-left:4px solid #EF4444;background:#fdf1f0;padding:12px 16px;border-radius:6px">
<h3>Analyst decision required: going-concern FAIL</h3>
<p>{{ o.precheck.reason }}. Read the basis and the passages in the pre-check below, then decide. <strong>Continue</strong>: overall score 10, the measures are shown as "superseded by going-concern fail" and not counted, and agent triggers are skipped. <strong>Stop</strong>: "Not scored: going-concern fail". The decision is recorded once and cannot be changed.</p>
<form class="review" method="post" action="{{ base }}/review">
<div><label for="reviewer">Reviewer</label><input id="reviewer" name="reviewer" required></div>
<div><label for="reason">Reason</label><input id="reason" name="reason" required placeholder="Why the analysis should continue or stop"></div>
<div class="buttons"><button class="primary-button" type="submit" name="decision" value="continue">Continue the analysis</button><button type="submit" name="decision" value="stop">Stop the analysis</button></div>
</form>
<p class="subtle">Command line: <code>python -m app.cli fo-review {{ view.run_id }} --decision continue|stop --reviewer "&lt;name&gt;" --reason "&lt;why&gt;"</code></p>
</div>
{% endif %}
{% if o.settings.errors %}<p class="notice">{{ o.settings.errors|join(' ') }}</p>{% endif %}
<div class="actions">{% if o.precheck %}<a href="#fo-precheck">Going concern</a>{% endif %}{% if o.covenants %}<a href="#fo-covenants">Covenants</a>{% endif %}{% if o.acquisitions %}<a href="#fo-acquisitions">Acquisitions</a>{% endif %}{% if o.prepaid %}<a href="#fo-prepaid">Prepaid model</a>{% endif %}{% if o.dscr_t1 %}<a href="#fo-dscr-t1">DSCR trigger T1</a>{% endif %}<a href="#fo-composite">Composite</a>{% for m in o.measures %}<a href="#fo-{{ m.key }}">{{ m.short }}</a>{% endfor %}</div>
<p class="subtle">Downloads: <a href="{{ base }}/overview.json">overview JSON</a> · <a href="{{ base }}/overview.html">standalone scorecard HTML</a></p>
<p class="subtle">{% if view.output_folder %}Saved files: <code>{{ view.output_folder }}</code> (financial_overview.json, financial_overview.html{% if (o.precheck and o.precheck.agent) or (o.covenants and o.covenants.agent) or (o.acquisitions and o.acquisitions.agent) or (o.prepaid and o.prepaid.agent) %}, precheck_transcript.json{% endif %}{% if view.review %}, review.json{% endif %}{% if view.overrides %}, overrides.json{% endif %}){% else %}No saved files for this run in this server's output folder (it may have been run with a different <code>--output</code>).{% endif %}</p>
</section>
{% with view = o %}{% include 'fo_scorecard.html.j2' %}{% endwith %}
{% endif %}
</main></body></html>
