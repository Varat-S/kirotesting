<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Financial Overview</title>{% include 'browser_style.html.j2' %}</head>
<body>
<header><span class="badge">Financial Overview</span><h1>{{ view.meta.entity_name or view.filing.folder }}</h1>
<p class="subtle">{{ view.meta.document_type or '10-K' }} for the period ending {{ view.meta.period_end or 'unknown' }}{% if view.meta.ticker %} · {{ view.meta.ticker }}{% endif %} · industry group: {{ view.industry.industry_group or 'not classified' }}</p>
{% if view.precheck %}<p>Going-concern pre-check: <span class="risk {{ view.precheck.css }}">{{ view.precheck.label }}</span> · {{ view.precheck.decided_by }}{% if view.precheck.agent and view.precheck.agent.stated %} · agent's answer {{ view.precheck.agent.stated.label }}{% endif %} · <a href="#fo-precheck">details</a>{% if view.gate.state == 'stopped' %} · <strong>Not scored: going-concern fail</strong>{% elif view.gate.state == 'awaiting_review' %} · <strong>awaiting analyst decision</strong>{% elif view.gate.state == 'awaiting_gc_decision' %} · <strong>the agent read FAIL against the verified evidence: awaiting analyst decision</strong>{% endif %}</p>{% endif %}
{% if view.covenants %}<p>Covenant pre-check: <span class="risk {{ view.covenants.css }}">{{ view.covenants.label }}</span> · outcome ({{ view.covenants.outcome }}) · {{ view.covenants.decided_by }}{% if view.covenants.agent and view.covenants.agent.stated %} · agent's answer {{ view.covenants.agent.stated.label }}{% endif %} · <a href="#fo-covenants">details</a>{% if view.gate.state == 'awaiting_override' and 'covenants' in view.gate.checks %} · <strong>awaiting analyst decision on the liquidity-and-maturity score</strong>{% elif view.gate.state == 'overridden' and 'covenants' in view.gate.checks %} · analyst decision recorded{% endif %}{% if view.covenants.info_flags %} · {{ view.covenants.info_flags|length }} information flag(s){% endif %}</p>{% endif %}
{% if view.acquisitions %}<p>Acquisitions and divestitures pre-check: <span class="risk {{ view.acquisitions.css }}">{{ view.acquisitions.label }}</span> · {{ view.acquisitions.deals|length }} deal(s) · {{ view.acquisitions.decided_by }} · <a href="#fo-acquisitions">details</a>{% if view.gate.state == 'awaiting_override' and 'acquisitions' in view.gate.checks %} · <strong>awaiting analyst decision on {{ view.acquisitions.unresolved|join(', ') }}</strong>{% elif view.gate.state == 'overridden' and 'acquisitions' in view.gate.checks %} · analyst decision recorded{% endif %}{% if view.acquisitions.info_flags %} · {{ view.acquisitions.info_flags|length }} information flag(s){% endif %}</p>{% endif %}
{% if view.prepaid %}<p>Prepaid-model pre-check: <span class="risk {{ view.prepaid.css }}">{{ view.prepaid.label }}</span> · {{ view.prepaid.decided_by }}{% if view.prepaid.factor is not none %} · DSO weight {{ view.prepaid.dso_weight }}{% endif %} · <a href="#fo-prepaid">details</a>{% if view.gate.state == 'awaiting_override' and 'prepaid' in view.gate.checks %} · <strong>awaiting analyst decision on DSO</strong>{% endif %}</p>{% endif %}
{% if view.dscr_t2 %}<p>DSCR trigger T2: <span class="risk {{ view.dscr_t2.css }}">{{ view.dscr_t2.label }}</span> · {% if view.dscr_t2.capex %}CapEx {{ view.dscr_t2.capex.multiple }} depreciation{% else %}CapEx against depreciation{% endif %} (fires above {{ '%g' % view.dscr_t2.multiple_threshold }}×) · <a href="#fo-dscr-t2">details</a>{% if view.gate.state == 'awaiting_override' and 'dscr_t2' in view.gate.checks %} · <strong>awaiting analyst decision on DSCR</strong>{% endif %}</p>{% endif %}
{% if view.dscr_t3 %}<p>DSCR trigger T3: <span class="risk {{ view.dscr_t3.css }}">{{ view.dscr_t3.label }}</span> · {% if view.dscr_t3.taxes %}cash taxes vs current tax expense: gap {{ view.dscr_t3.taxes.gap_share }} of CFADS{% else %}cash taxes vs current tax expense{% endif %} (fires above {{ view.dscr_t3.share_threshold }}) · <a href="#fo-dscr-t3">details</a>{% if view.gate.state == 'awaiting_override' and 'dscr_t3' in view.gate.checks %} · <strong>awaiting analyst decision on DSCR</strong>{% endif %}</p>{% endif %}
{% if view.dscr_t1 %}<p>DSCR trigger T1: <span class="risk {{ view.dscr_t1.css }}">{{ view.dscr_t1.label }}</span> · DSCR score {{ view.dscr_t1.score.text }} (fires at {{ view.dscr_t1.threshold }} or more) · <a href="#fo-dscr-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'dscr_t1' in view.gate.checks %} · <strong>awaiting analyst decision on DSCR</strong>{% endif %}</p>{% endif %}
{% if view.icr_t2 %}<p>ICR trigger T2: <span class="risk {{ view.icr_t2.css }}">{{ view.icr_t2.label }}</span> · {% if view.icr_t2.inputs %}interest from {{ view.icr_t2.inputs.kind }}{% else %}interest tag{% endif %} · <a href="#fo-icr-t2">details</a>{% if view.gate.state == 'awaiting_override' and 'icr_t2' in view.gate.checks %} · <strong>awaiting analyst decision on ICR</strong>{% endif %}</p>{% endif %}
{% if view.icr_t3 %}<p>ICR trigger T3: <span class="risk {{ view.icr_t3.css }}">{{ view.icr_t3.label }}</span> · EBIT from operating income · <a href="#fo-icr-t3">details</a>{% if view.gate.state == 'awaiting_override' and 'icr_t3' in view.gate.checks %} · <strong>awaiting analyst decision on ICR</strong>{% endif %}</p>{% endif %}
{% if view.icr_t1 %}<p>ICR trigger T1: <span class="risk {{ view.icr_t1.css }}">{{ view.icr_t1.label }}</span> · ICR score {{ view.icr_t1.score.text }} (fires at {{ view.icr_t1.threshold }} or more) · <a href="#fo-icr-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'icr_t1' in view.gate.checks %} · <strong>awaiting analyst decision on ICR</strong>{% endif %}</p>{% endif %}
{% if view.leverage_t1 %}<p>Debt/EBITDAR trigger T1: <span class="risk {{ view.leverage_t1.css }}">{{ view.leverage_t1.label }}</span> · net one-offs against EBITDAR (fires above {{ view.leverage_t1.share_threshold }}, or EBITDAR ≤ 0) · <a href="#fo-leverage-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'leverage_t1' in view.gate.checks %} · <strong>awaiting analyst decision on Debt/EBITDAR</strong>{% endif %}</p>{% endif %}
{% if view.leverage_t2 %}<p>Debt/EBITDAR trigger T2: <span class="risk {{ view.leverage_t2.css }}">{{ view.leverage_t2.label }}</span> · {% if view.leverage_t2.inputs %}gross score {{ view.leverage_t2.inputs.gross_score.text }} vs net score {{ view.leverage_t2.inputs.net_score.text }}{% else %}gross vs net leverage score{% endif %} (fires {{ view.leverage_t2.gap_threshold }} or more apart) · <a href="#fo-leverage-t2">details</a>{% if view.gate.state == 'awaiting_override' and 'leverage_t2' in view.gate.checks %} · <strong>awaiting analyst decision on Debt/EBITDAR</strong>{% endif %}</p>{% endif %}
{% if view.leverage_t3 %}<p>Debt/EBITDAR trigger T3: <span class="risk {{ view.leverage_t3.css }}">{{ view.leverage_t3.label }}</span> · {% if view.leverage_t3.inputs %}score with leases {{ view.leverage_t3.inputs.score.text }} vs without {{ view.leverage_t3.inputs.score_without.text }}{% else %}leverage score with vs without leases{% endif %} (fires {{ view.leverage_t3.gap_threshold }} or more worse) · <a href="#fo-leverage-t3">details</a>{% if view.gate.state == 'awaiting_override' and 'leverage_t3' in view.gate.checks %} · <strong>awaiting analyst decision on Debt/EBITDAR</strong>{% endif %}</p>{% endif %}
{% if view.leverage_t4 %}<p>Debt/EBITDAR trigger T4: <span class="risk {{ view.leverage_t4.css }}">{{ view.leverage_t4.label }}</span> · total debt from a fallback (the tagged total skipped, or finance leases added) · <a href="#fo-leverage-t4">details</a>{% if view.gate.state == 'awaiting_override' and 'leverage_t4' in view.gate.checks %} · <strong>awaiting analyst decision on Debt/EBITDAR</strong>{% endif %}</p>{% endif %}
{% if view.rcf_t1 %}<p>RCF/Debt trigger T1: <span class="risk {{ view.rcf_t1.css }}">{{ view.rcf_t1.label }}</span> · RCF / debt score {{ view.rcf_t1.score.text }} (fires at {{ view.rcf_t1.threshold }} or more, or below zero) · <a href="#fo-rcf-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'rcf_t1' in view.gate.checks %} · <strong>awaiting analyst decision on RCF / debt</strong>{% endif %}</p>{% endif %}
{% if view.rcf_t2 %}<p>RCF/Debt trigger T2: <span class="risk {{ view.rcf_t2.css }}">{{ view.rcf_t2.label }}</span> · one-off cash inflow (tagged inflows above {{ view.rcf_t2.share_threshold }} of FFO, or FFO up {{ view.rcf_t2.growth_threshold }} or more and over {{ view.rcf_t2.excess_threshold }} faster than revenue) · <a href="#fo-rcf-t2">details</a>{% if view.gate.state == 'awaiting_override' and 'rcf_t2' in view.gate.checks %} · <strong>awaiting analyst decision on RCF / debt</strong>{% endif %}</p>{% endif %}
{% if view.rcf_t3 %}<p>RCF/Debt trigger T3: <span class="risk {{ view.rcf_t3.css }}">{{ view.rcf_t3.label }}</span> · NCI distributions not tagged under a standard concept while NCI is material · <a href="#fo-rcf-t3">details</a>{% if view.gate.state == 'awaiting_override' and 'rcf_t3' in view.gate.checks %} · <strong>awaiting analyst decision on RCF / debt</strong>{% endif %}</p>{% endif %}
{% if view.rcf_t4 %}<p>RCF/Debt trigger T4: <span class="risk {{ view.rcf_t4.css }}">{{ view.rcf_t4.label }}</span> · NCI distributions from <code>{{ view.rcf_t4.concept }}</code> (may hold buyouts) · <a href="#fo-rcf-t4">details</a>{% if view.gate.state == 'awaiting_override' and 'rcf_t4' in view.gate.checks %} · <strong>awaiting analyst decision on RCF / debt</strong>{% endif %}</p>{% endif %}
{% if view.margin_t1 %}<p>EBITDAR Margin trigger T1: <span class="risk {{ view.margin_t1.css }}">{{ view.margin_t1.label }}</span> · one-offs Debt/EBITDAR T1 removed, placed in or outside revenue · <a href="#fo-margin-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'margin_t1' in view.gate.checks %} · <strong>awaiting analyst decision on the EBITDAR margin</strong>{% endif %}</p>{% endif %}
{% if view.margin_t2 %}<p>EBITDAR Margin trigger T2: <span class="risk {{ view.margin_t2.css }}">{{ view.margin_t2.label }}</span> · EBITDAR margin score {{ view.margin_t2.score.text }} (fires at {{ view.margin_t2.high }} or more, or {{ view.margin_t2.low }} or less, when one large segment's margin is far from the rest) · <a href="#fo-margin-t2">details</a>{% if view.gate.state == 'awaiting_override' and 'margin_t2' in view.gate.checks %} · <strong>awaiting analyst decision on the EBITDAR margin</strong>{% endif %}</p>{% endif %}
{% if view.dso_t1 %}<p>DSO trigger T1: <span class="risk {{ view.dso_t1.css }}">{{ view.dso_t1.label }}</span> · change in DSO {{ view.dso_t1.inputs.change if view.dso_t1.inputs else '' }} (fires at {{ view.dso_t1.threshold }} days or more either way) · <a href="#fo-dso-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'dso_t1' in view.gate.checks %} · <strong>awaiting analyst decision on DSO</strong>{% endif %}</p>{% endif %}
{% if view.liquidity_t1 %}<p>Liquidity trigger T1: <span class="risk {{ view.liquidity_t1.css }}">{{ view.liquidity_t1.label }}</span> · revolver availability at the year-end not found in the extracted data · <a href="#fo-liquidity-t1">details</a>{% if view.gate.state == 'awaiting_override' and 'liquidity_t1' in view.gate.checks %} · <strong>awaiting analyst decision on liquidity and debt maturity</strong>{% endif %}</p>{% endif %}
{% if view.liquidity_t2 %}<p>Liquidity trigger T2: <span class="risk {{ view.liquidity_t2.css }}">{{ view.liquidity_t2.label }}</span> · coverage or refinancing score {{ view.liquidity_t2.threshold }} or more after T1 · <a href="#fo-liquidity-t2">details</a>{% if view.gate.state == 'awaiting_override' and 'liquidity_t2' in view.gate.checks %} · <strong>awaiting analyst decision on liquidity and debt maturity</strong>{% endif %}</p>{% endif %}
{% if view.liquidity_t3 %}<p>Liquidity trigger T3: <span class="risk {{ view.liquidity_t3.css }}">{{ view.liquidity_t3.label }}</span> · largest year of maturities in years 2–5 at 25% or more of total debt · <a href="#fo-liquidity-t3">details</a>{% if view.gate.state == 'awaiting_override' and 'liquidity_t3' in view.gate.checks %} · <strong>awaiting analyst decision on liquidity and debt maturity</strong>{% endif %}</p>{% endif %}
{% if run %}<p class="subtle">Case {{ run.case_id }} · run <code>{{ run.run_id }}</code> · {{ run.started_at }} · content hash <code>{{ run.content_hash[:16] }}</code></p>{% endif %}
<p class="notice">Deterministic scorecard computed from the filing's Inline XBRL tags, gated by the going-concern, covenant, acquisitions-and-divestitures and prepaid-model pre-checks, with the DSCR trigger agents (T2, T3, T1), the ICR trigger agents (T2, T3, T1), the Debt/EBITDAR trigger agents (T4, T1, T2, T3) , the RCF/Debt trigger agents (T1-T4), the EBITDAR Margin trigger agents (T1, T2) and the DSO trigger agent (T1). Illustrative methodology, not bank policy; review before use.</p>
</header>
<main>
{% include 'fo_scorecard.html.j2' %}
</main></body></html>
