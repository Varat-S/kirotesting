{# Financial Overview scorecard: the composite then one card per measure. Expects `view` from fo.reporting.overview_view. #}
<style>
  .risk { display: inline-block; min-width: 2.6rem; text-align: center; border-radius: 6px; padding: 1px 8px; font-weight: 700; color: #fff; }
  .risk.very-low { background: #10B981; } .risk.low { background: #84CC16; } .risk.moderate { background: #EAB308; }
  .risk.elevated { background: #F59E0B; } .risk.high { background: #F97316; } .risk.very-high { background: #EF4444; }
  .risk.none { background: #c9d1da; color: #22334a; }
  .fo-headline { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 18px; }
  .fo-big { font-size: 2.2rem; font-weight: 700; } .fo-rating { font-size: 1.6rem; font-weight: 700; color: #22334a; }
  .fo-card h3 { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  tr.result td { background: #f8fafd; font-weight: 600; }
  .fo-formula { font-family: ui-monospace, monospace; font-size: .88rem; background: #f8fafd; padding: 8px 12px; border-radius: 6px; }
  .fo-gate { border-left: 4px solid #EF4444; background: #fdf1f0; padding: 10px 14px; border-radius: 6px; }
  .fo-gate.continued { border-color: #F97316; background: #fff6ee; } .fo-gate.watch { border-color: #F59E0B; background: #fff9ec; }
  .fo-quote { border-left: 3px solid #c9d1da; margin: 6px 0; padding: 4px 12px; font-style: italic; }
  .fo-superseded { opacity: .72; }
  .ok { color: #2f6b45; font-weight: bold; } .bad { color: #9a3324; font-weight: bold; } .warn { color: #8a6d1c; font-weight: bold; }
  .fo-agents-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; margin-top: 0; }
  .fo-agents-tools button { font-size: .85rem; padding: 4px 10px; }
  .fo-agent { border-top: 1px solid #e7ecf2; scroll-margin-top: 20px; }
  .fo-agent > details.fo-agent-box { margin: 0; }
  .fo-agent summary { display: flex; align-items: center; gap: 6px 12px; padding: 9px 2px; color: inherit; list-style: none; }
  .fo-agent summary::-webkit-details-marker { display: none; }
  .fo-agent summary::before { content: "▸"; color: #155cb7; transition: transform .15s; }
  .fo-agent details[open] > summary::before { transform: rotate(90deg); }
  .fo-agent summary:hover { background: #f8fafd; }
  .fo-agent-title { font-weight: 600; flex: 0 0 28rem; }
  .fo-agent summary .risk { flex: 0 0 auto; font-size: .82rem; }
  .fo-agent-reason { flex: 1; min-width: 0; color: #5b6c80; font-size: .92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fo-agent details[open] > summary { flex-wrap: wrap; }
  .fo-agent details[open] > summary .fo-agent-reason { white-space: normal; flex-basis: 100%; order: 10; padding-left: 22px; }
  .fo-agent-body { padding: 4px 4px 18px 22px; }
  .fo-attn { flex: 0 0 auto; color: #9a3324; background: #fdf1f0; border: 1px solid #EF4444; border-radius: 6px; padding: 1px 8px; font-size: .82rem; font-weight: 700; }
  .fo-decision { margin: 6px 0 16px; } .fo-decision h3 { margin-top: 0; }
  .fo-agent-body h3 { font-size: 1.05rem; margin-top: 18px; }
  @media (max-width: 800px) { .fo-agent summary { flex-wrap: wrap; } .fo-agent-title { flex-basis: auto; } .fo-agent-reason { flex-basis: 100%; } }
</style>
{% set pc = view.precheck %}
{% set gate = view.gate %}
{# What waits for an analyst, by agent check: each decision is shown in the row of the check that raised it (an
   escalation merged from several checks is shown in its first check's row; the others point to it). The forms are
   rendered only on the workbench (`decision_base`); the standalone page gives the command line. #}
{% set needs = (gate.checks or []) if gate.state in ('awaiting_override', 'awaiting_gc_decision') else (['going_concern'] if gate.state == 'awaiting_review' else []) %}
{% set rid = decision_run_id if decision_run_id is defined else ((run.run_id if run else none) or 'RUN_ID') %}
{% set forms = decision_base is defined and decision_base %}
{% macro trigger_agent_result(t, name) %}
{% set a = t.agent %}
<h3 id="fo-{{ (name if ' ' in name else 'dscr ' ~ name)|lower|replace('/', '-')|replace(' ', '-') }}-agent">Trigger Agent result: {{ name if ' ' in name else 'DSCR ' ~ name }}</h3>
{% if a %}
<dl>
<dt>Agent's answer</dt><dd>{% if a.stated %}<span class="risk {{ a.stated.css }}">{{ a.stated.label }}</span>{% endif %}</dd>
<dt>Verified result</dt><dd><span class="risk {{ t.css }}">{{ t.label }}</span> {% if a.consistent %}<span class="subtle">matches the agent's answer</span>{% else %}<span class="warn">differs from the agent's answer: the verified evidence decides</span>{% endif %}</dd>
<dt>Model run</dt><dd><code>{{ a.model_id }}</code> · prompt <code>{{ a.prompt_id }}</code> (hash <code>{{ a.prompt_hash }}</code>) · run <code>{{ a.model_run_id }}</code> · {{ a.passages_sent }} passages sent · output {{ a.validation_outcome }}</dd>
</dl>
{% if a.rationale %}<p><strong>Agent's rationale:</strong> {{ a.rationale }}</p>{% endif %}
{% if a.held_back %}
<div class="table-wrap"><table><thead><tr><th>Item</th><th>Fact</th><th>Passage</th><th>Quote</th><th>Check</th></tr></thead><tbody>
{% for h in a.held_back %}<tr><td><code>{{ h.item_id }}</code></td><td>{{ h.fact }}{% if h.amount %} {{ h.amount }}{% endif %}</td><td><code>{{ h.passage_id }}</code></td><td><span class="fo-quote" style="display:block">{{ h.quote }}</span></td><td><span class="bad">Held back: {{ h.reason }}</span></td></tr>{% endfor %}
</tbody></table></div>
{% endif %}
{% if a.missing_information %}<p class="subtle"><strong>Missing information:</strong> {{ a.missing_information|join('; ') }}</p>{% endif %}
<p class="subtle">The full exchange (system prompt, inputs, raw response) is in <code>trigger_transcript.json</code> in the run's output folder.</p>
{% else %}<p class="subtle">{{ t.agent_not_used }}</p>{% endif %}
{% endmacro %}
{% macro attention(key) %}{% if key in needs %}<span class="fo-attn" title="An analyst must check this and decide">&#9888; Analyst decision required</span>{% endif %}{% endmacro %}
{% macro recomputed(key, title='Recomputed', note=None) %}{% set rs = (view.recomputations or [])|selectattr('step', 'equalto', key)|list %}{% if rs %}
<div class="fo-recomputed"><h4>{{ title }}</h4>{% if note %}<p class="notice">{{ note }}</p>{% endif %}
<div class="table-wrap"><table><thead><tr><th>Measure</th><th>Column</th><th>Inputs changed</th><th>Result (before → after)</th></tr></thead><tbody>
{% for r in rs %}<tr><td>{{ r.measure_name }}</td><td>{{ r.column }}</td><td>{% for i in r.inputs %}{{ i.label }}: {{ i.before }} → {{ i.after }}{% if not loop.last %}<br>{% endif %}{% else %}—{% endfor %}</td><td>{% for x in r.results %}{% if x.score %}<strong>{{ x.label }}: {{ x.before }} → {{ x.after }}</strong>{% if x.unchanged %} <span class="subtle">(unchanged)</span>{% endif %}{% else %}{{ x.label }}: {{ x.before }} → {{ x.after }}{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endfor %}
</tbody></table></div><p class="subtle">Amounts in millions. {% if key.endswith(':agent') %}Code worked it out from the agent's answer as stated (the agent quotes and classifies; it never computes). Not applied: the engine scored the verified result.{% else %}The step's own recomputation, as code worked it out from the verified evidence (the agent quotes and classifies; it never computes).{% endif %}</p></div>
{% endif %}{% endmacro %}
{% macro agent_recomputed(key) %}{% set r = (view.agent_readings or {}).get(key) %}{% if r %}
<div class="fo-compare"><h4>Verified result and the agent's answer</h4>
<div class="table-wrap"><table><thead><tr><th></th><th>Outcome</th><th>{{ r.measure_name }} score ({{ r.column }})</th></tr></thead><tbody>
{% if r.scores %}<tr><td>As calculated, before this check</td><td>—</td><td><span class="risk {{ r.scores.calculated.css }}">{{ r.scores.calculated.text }}</span></td></tr>{% endif %}
<tr><td><strong>Verified result (applied)</strong></td><td>{{ r.verified }}</td><td>{% if r.scores %}<span class="risk {{ r.scores.verified.css }}">{{ r.scores.verified.text }}</span>{% endif %}</td></tr>
<tr><td>The agent's answer, as stated (not applied)</td><td>{{ r.stated }}{% if not r.agrees %} <span class="warn">differs</span>{% endif %}</td><td>{% if r.scores %}<span class="risk {{ r.scores.agent.css }}">{{ r.scores.agent.text }}</span>{% if r.same_score %} <span class="subtle">(same score)</span>{% endif %}{% endif %}</td></tr>
</tbody></table></div>
<p class="subtle">The verified result is what the engine scored. The agent's answer is its status, items and amounts taken exactly as it gave them, with no check against the filing or this check's rules; an analyst can compare the two and, where the measure is escalated, accept the engine's score or override it.</p>
{{ recomputed(key ~ ':agent', "The agent's answer, recomputed (not applied)") }}
{% for n in r.notes %}<p class="subtle">{{ n }}</p>{% endfor %}</div>
{% endif %}{% endmacro %}
{% macro recomputations_of(key) %}{% set rs = (view.applied_recomputations or [])|selectattr('measure', 'equalto', key)|list %}{% if rs %}
<details class="fo-recomputations" open><summary>Recomputations ({{ rs|length }} step{{ 's' if rs|length != 1 }})</summary>
<div class="table-wrap"><table><thead><tr><th>Step</th><th>Column</th><th>Inputs changed</th><th>Result (before → after)</th></tr></thead><tbody>
{% for r in rs %}<tr><td>{{ r.by }}</td><td>{{ r.column }}</td><td>{% for i in r.inputs %}{{ i.label }}: {{ i.before }} → {{ i.after }}{% if not loop.last %}<br>{% endif %}{% else %}—{% endfor %}</td><td>{% for x in r.results %}{% if x.score %}<strong>{{ x.label }}: {{ x.before }} → {{ x.after }}</strong>{% if x.unchanged %} <span class="subtle">(unchanged)</span>{% endif %}{% else %}{{ x.label }}: {{ x.before }} → {{ x.after }}{% endif %}{% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endfor %}
</tbody></table></div><p class="subtle">In run order: each pre-check, then each trigger that changed this measure. Amounts in millions.</p></details>
{% endif %}{% endmacro %}
{% macro decision_panel(key) %}
{% if key == 'going_concern' and gate.state == 'awaiting_gc_decision' %}
<div id="review" class="fo-gate fo-decision">
<h3>Analyst decision required: going concern (agent and verified evidence disagree)</h3>
<p>{{ gate.gc_decision.reason }}. The agent's FAIL quote did not hold up against the filing (see "Held back" below), so the engine scored the run on the verified result. Read the agent's answer and the passages, then decide. <strong>Use the verified result</strong>: the run is scored as calculated (any measure still escalated waits for its own decision). <strong>Continue</strong> or <strong>Stop</strong>: side with the agent's FAIL (continue: overall score 10, measures superseded; stop: "Not scored: going-concern fail"). The decision is recorded once and cannot be changed.</p>
{% if forms %}<form class="review" method="post" action="{{ decision_base }}/review">
<div><label for="reviewer">Reviewer</label><input id="reviewer" name="reviewer" required></div>
<div><label for="reason">Reason</label><input id="reason" name="reason" required placeholder="Why"></div>
<div class="buttons"><button class="primary-button" type="submit" name="decision" value="use_verified">Use the verified result ({{ gate.gc_decision.verified|upper }})</button><button type="submit" name="decision" value="continue">Fail: continue at score 10</button><button type="submit" name="decision" value="stop">Fail: stop the analysis</button></div>
</form>{% endif %}
<p class="subtle">Command line: <code>python -m app.cli fo-review {{ rid }} --decision use_verified|continue|stop --reviewer "&lt;name&gt;" --reason "&lt;why&gt;"</code></p>
</div>
{% endif %}
{% if key == 'going_concern' and gate.state == 'awaiting_review' %}
<div id="review" class="fo-gate fo-decision">
<h3>Analyst decision required: going-concern FAIL</h3>
<p>{{ pc.reason }}. Read the basis and the passages below, then decide. <strong>Continue</strong>: overall score 10, the measures are shown as "superseded by going-concern fail" and not counted, and agent triggers are skipped. <strong>Stop</strong>: "Not scored: going-concern fail". The decision is recorded once and cannot be changed.</p>
{% if forms %}<form class="review" method="post" action="{{ decision_base }}/review">
<div><label for="reviewer">Reviewer</label><input id="reviewer" name="reviewer" required></div>
<div><label for="reason">Reason</label><input id="reason" name="reason" required placeholder="Why the analysis should continue or stop"></div>
<div class="buttons"><button class="primary-button" type="submit" name="decision" value="continue">Continue the analysis</button><button type="submit" name="decision" value="stop">Stop the analysis</button></div>
</form>{% endif %}
<p class="subtle">Command line: <code>python -m app.cli fo-review {{ rid }} --decision continue|stop --reviewer "&lt;name&gt;" --reason "&lt;why&gt;"</code></p>
</div>
{% endif %}
{% if gate.state in ('awaiting_override', 'awaiting_gc_decision') %}
{% for e in gate.pending or [] %}
{% set hosts = e.checks or [e.check] %}
{% if hosts[0] == key %}
<div id="override-{{ e.measure }}" class="fo-gate fo-decision">
<h3>Analyst decision required: {{ e.measure_name }} ({{ e.title or 'covenant breach' }})</h3>
<p>{{ e.reason }}. {{ e.detail or 'The engine set revolver availability to 0 and the score to 10.' }} Engine score: <strong>{{ e.engine_score if e.engine_score is not none else 'none' }}</strong>{% if e.calculated_score is not none %} (calculated before the adjustment: {{ e.calculated_score }}){% endif %}. Read this check below, then accept the engine's score or enter your own (1–10). The composite is re-weighted on the score you record. The decision is recorded once and cannot be changed.</p>
{% if forms %}<form class="review" method="post" action="{{ decision_base }}/override">
<input type="hidden" name="measure" value="{{ e.measure }}">
<div><label for="reviewer-{{ e.measure }}">Reviewer</label><input id="reviewer-{{ e.measure }}" name="reviewer" required></div>
<div><label for="reason-{{ e.measure }}">Reason</label><input id="reason-{{ e.measure }}" name="reason" required placeholder="Why this score"></div>
<div><label for="score-{{ e.measure }}">Your score (1–10, for an override)</label><input id="score-{{ e.measure }}" name="score" type="number" min="1" max="10" step="0.1"></div>
<div class="buttons"><button class="primary-button" type="submit" name="decision" value="accept">Accept the engine's score ({{ e.engine_score }})</button><button type="submit" name="decision" value="override">Override with my score</button></div>
</form>{% endif %}
<p class="subtle">Command line: <code>python -m app.cli fo-override {{ rid }} --measure {{ e.measure }} --decision accept|override [--score N] --reviewer "&lt;name&gt;" --reason "&lt;why&gt;"</code></p>
</div>
{% elif key in hosts %}
<p class="fo-gate"><strong>&#9888; This check is part of the {{ e.measure_name }} decision:</strong> <a href="#override-{{ e.measure }}">decide it in the {{ hosts[0]|replace('_', ' ')|replace('dscr t', 'DSCR T')|replace('icr t', 'ICR T')|replace('leverage t', 'Debt/EBITDAR T')|replace('rcf t', 'RCF/Debt T')|replace('margin t', 'EBITDAR Margin T')|replace('dso t', 'DSO T') }} row</a>.</p>
{% endif %}
{% endfor %}
{% endif %}
{% endmacro %}
{% if pc or view.covenants or view.acquisitions or view.prepaid or view.dscr_t2 or view.dscr_t3 or view.dscr_t1 or view.icr_t2 or view.icr_t3 or view.icr_t1 or view.leverage_t1 or view.leverage_t2 or view.leverage_t3 or view.leverage_t4 or view.rcf_t1 or view.rcf_t2 or view.rcf_t3 or view.rcf_t4 or view.margin_t1 or view.margin_t2 or view.dso_t1 or view.liquidity_t1 or view.liquidity_t2 or view.liquidity_t3 %}<section id="fo-agents"><h2 class="fo-agents-head"><span>Agent checks</span> <span class="fo-agents-tools"><button type="button" data-fo-agents="open">Expand all</button> <button type="button" data-fo-agents="close">Collapse all</button></span></h2>{% endif %}
{% if pc %}
<div id="fo-precheck" class="fo-agent"><details class="fo-agent-box"><summary><span class="fo-agent-title">Pre-check: going concern</span> <span class="risk {{ pc.css }}">{{ pc.label }}</span> <span class="fo-agent-reason">{{ pc.reason }}</span>{{ attention('going_concern') }}</summary>
<div class="fo-agent-body">
{{ decision_panel('going_concern') }}{{ recomputed('going_concern') }}
<dl>
<dt>Decided by</dt><dd>{{ pc.decided_by }}{% if pc.agent %} · {{ pc.mode }} model <code>{{ pc.agent.model_id }}</code> · prompt <code>{{ pc.agent.prompt_id }}</code>{% endif %}</dd>
<dt>Effect</dt><dd>{{ pc.effect }}</dd>
<dt>Keyword rules (cross-check only)</dt><dd>{{ pc.rules.status|upper }}: {{ pc.rules.reason }}{% if pc.rules.passage_id %} ({{ pc.rules.passage_id }}){% endif %}</dd>
<dt>Auditor's report</dt><dd>{% if pc.audit_reports %}read in full ({{ pc.passages[0].entries|length }} paragraphs) in {% for i in pc.audit_reports %}{{ 'F-pages' if i == 'F' else ('Item ' ~ i if i else 'the document') }}{{ ', ' if not loop.last }}{% endfor %}{% else %}not located{% endif %}</dd>
{% if pc.sections %}<dt>Sections searched</dt><dd>{% for s in pc.sections %}{{ s.label }}: {% if s.located %}located{% else %}<span class="subtle">no heading found</span>{% endif %}{% if s.mentions %}, {{ s.mentions }} mention(s){% endif %}{{ ' · ' if not loop.last }}{% endfor %}</dd>{% endif %}
{% if pc.status == 'fail' %}<dt>Agent triggers</dt><dd>Skipped (going-concern fail)</dd>{% endif %}
</dl>
{% if gate.message and gate.state in ['stopped', 'continued', 'awaiting_review', 'awaiting_gc_decision'] %}<p class="fo-gate {{ gate.state }}"><strong>{{ gate.message }}</strong></p>{% elif pc.status == 'watch' %}<p class="fo-gate watch">{{ pc.effect }}</p>{% endif %}
{% for b in pc.basis %}<p class="subtle">Basis {{ b.passage_id }} · {{ b.section or "Auditor's report" }} · {{ 'F-pages' if b.item == 'F' else ('Item ' ~ b.item if b.item else 'document') }} · {{ b.classification|replace('_', ' ') }}</p><blockquote class="fo-quote">{{ b.quote }}</blockquote>{% endfor %}
{% for n in pc.notes %}<p class="notice">{{ n }}</p>{% endfor %}
{% set a = pc.agent %}
<h3 id="fo-precheck-agent">Pre-check Agent result</h3>
{% if a %}
<dl>
<dt>Agent's answer</dt><dd>{% if a.stated %}<span class="risk {{ a.stated.css }}">{{ a.stated.label }}</span>{% else %}<span class="subtle">none (output rejected)</span>{% endif %}</dd>
<dt>Verified result</dt><dd>{% if a.verified %}<span class="risk {{ a.verified.css }}">{{ a.verified.label }}</span> {% if a.consistent %}<span class="subtle">matches the agent's answer</span>{% else %}<span class="warn">differs from the agent's answer: the verified findings decide</span>{% endif %}{% else %}<span class="subtle">not available (a run recorded before the agent was required: the keyword rules decided)</span>{% endif %}</dd>
<dt>Model run</dt><dd><code>{{ a.model_id }}</code> · prompt <code>{{ a.prompt_id }}</code> (hash <code>{{ a.prompt_hash }}</code>) · run <code>{{ a.model_run_id }}</code> · {{ a.passages_sent }} passages sent · output {{ a.validation_outcome }}</dd>
</dl>
{% if a.validation_outcome != 'valid' %}<p class="notice">Agent output rejected: {{ a.validation_detail }}. (A run recorded before the agent was required: the keyword rules decided.)</p>{% endif %}
{% if a.rationale %}<p><strong>Agent's rationale:</strong> {{ a.rationale }}</p>{% endif %}
{% if a.validation_outcome == 'valid' %}
{% if a.findings %}
<div class="table-wrap"><table><thead><tr><th>Passage</th><th>Section</th><th>Classification</th><th>Quote</th><th>Check</th></tr></thead><tbody>
{% for f in a.findings %}<tr><td><code>{{ f.passage_id }}</code></td><td>{{ f.section }}</td><td>{{ f.classification|replace('_', ' ') }}</td><td><span class="fo-quote" style="display:block">{{ f.quote }}</span></td><td>{% if f.verified %}<span class="ok">{{ f.verdict }}</span>{% else %}<span class="bad">{{ f.verdict }}</span>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="subtle">The agent reported no findings: nothing it read bears on going concern.</p>{% endif %}
{% endif %}
{% if a.missing_information %}<p class="subtle"><strong>Missing information:</strong> {{ a.missing_information|join('; ') }}</p>{% endif %}
<p class="subtle">The full exchange (system prompt, inputs, raw response) is in <code>precheck_transcript.json</code> in the run's output folder.</p>
{% else %}<p class="subtle">{{ pc.agent_not_used }}</p>{% endif %}
<details><summary>Passages read ({% for p in pc.passages %}{{ p.entries|length }} {{ p.label|lower }}{{ ', ' if not loop.last }}{% endfor %}{% if pc.tagged %}, {{ pc.tagged|length }} tagged facts{% endif %})</summary>
{% for p in pc.passages %}<h4>{{ p.label }}</h4>{% if p.entries %}<ul>{% for e in p.entries %}<li><code>{{ e.passage_id }}</code> <span class="subtle">{{ 'F-pages' if e.item == 'F' else ('Item ' ~ e.item if e.item else 'document') }}{% if e.section_label %} · {{ e.section_label }}{% endif %}</span> {{ e.text }}</li>{% endfor %}</ul>{% else %}<p class="subtle">None.</p>{% endif %}{% endfor %}
{% if pc.tagged %}<h4>Tagged going-concern facts</h4><ul>{% for t in pc.tagged %}<li><code>{{ t.concept }}</code> {{ t.period }}: {{ t.value }}</li>{% endfor %}</ul>{% endif %}
<p class="subtle">The auditor's report is always read in full; the going-concern or liquidity note, basis of presentation, MD&amp;A liquidity and subsequent events (with the rest of Items 1, 1A, 7, 8 and the F-pages) are searched for "substantial doubt" and "going concern". Pass: no statement of substantial doubt; standard "prepared on a going-concern basis" wording, or risk-factor language with no doubt expressed, is a pass. Watch: management says substantial doubt was raised but is alleviated by its plans; the liquidity-and-maturity score is floored at 7 before weighting. Fail: the auditor's report has a going-concern paragraph, or management concludes substantial doubt exists (not alleviated); the pipeline pauses for an analyst to choose continue (overall score 10, measures shown as "superseded by going-concern fail" and not counted, agent triggers skipped) or stop ("Not scored: going-concern fail"). Going-concern doubt can also arise after the 10-K: check later 10-Qs and 8-Ks.</p>
</details>
</div></details></div>
{% endif %}
{% set cv = view.covenants %}
{% if cv %}
<div id="fo-covenants" class="fo-agent"><details class="fo-agent-box"><summary><span class="fo-agent-title">Pre-check: covenants</span> <span class="risk {{ cv.css }}">{{ cv.label }}</span> <span class="fo-agent-reason">Outcome ({{ cv.outcome }}): {{ cv.reason }}</span>{{ attention('covenants') }}</summary>
<div class="fo-agent-body">
{{ decision_panel('covenants') }}{{ recomputed('covenants') }}
<dl>
<dt>Decided by</dt><dd>{{ cv.decided_by }}{% if cv.agent %} · {{ cv.mode }} model <code>{{ cv.agent.model_id }}</code> · prompt <code>{{ cv.agent.prompt_id }}</code>{% endif %}</dd>
<dt>Effect</dt><dd>{{ cv.effect }}</dd>
<dt>Keyword rules (cross-check only)</dt><dd>{{ cv.rules.label }}: {{ cv.rules.reason }}{% if cv.rules.findings %} ({{ cv.rules.findings|length }} classified sentence(s)){% endif %}</dd>
{% if cv.sections %}<dt>Sections searched</dt><dd>{% for s in cv.sections %}{{ s.label }}: {% if s.located %}located{% else %}<span class="subtle">no heading found</span>{% endif %}{% if s.hits %}, {{ s.hits }} paragraph(s) with hits{% endif %}{{ ' · ' if not loop.last }}{% endfor %}</dd>{% endif %}
{% if cv.waivers %}<dt>Waivers</dt><dd>{% for w in cv.waivers %}<code>{{ w.passage_id }}</code> {% if w.months is not none %}runs {{ '%.0f'|format(w.months) }} months after the year-end{% else %}length not stated{% endif %}{{ ' · ' if not loop.last }}{% endfor %}</dd>{% endif %}
