.liquidity_t2 %} · Liquidity trigger T2: {{ view.liquidity_t2.label|lower }}{% endif %}{% if view.liquidity_t3 %} · Liquidity trigger T3: {{ view.liquidity_t3.label|lower }}{% endif %}.</p>{% endif %}
<div class="table-wrap"><table><thead><tr><th>Measure</th><th>Score</th><th>Column</th><th class="num">Weight</th><th class="num">Share</th><th class="num">Adds</th><th>Notes</th></tr></thead><tbody>
{% for r in c.rows %}<tr><td>{{ r.name }}</td><td><span class="risk {{ r.score.css }}">{{ r.score.text }}</span></td><td>{{ r.heading }}</td><td class="num">{{ r.weight }}</td><td class="num">{{ r.share }}</td><td class="num">{{ r.contribution }}</td><td>{{ r.notes }}</td></tr>{% endfor %}
</tbody></table></div>
{{ recomputations_of('overall') }}
<p class="subtle">Scale: 1 = lowest risk, 10 = highest. Rating AAA (1) … D (10); the first decimal notches it (+ below .5, − above .5).</p>
<details><summary>Method and limitations</summary><p class="fo-formula">{{ c.formula }}</p><p>{{ c.notes }}</p><p class="subtle">{{ c.gaps }}</p></details>
</section>
{% else %}
<section id="fo-composite"><h2>Composite risk score</h2>{% if gate.state == 'stopped' %}<p class="fo-big">Not scored: going-concern fail</p>{% else %}<p class="notice">Withheld: the going-concern fail is awaiting an analyst's decision (continue or stop).</p>{% endif %}</section>
{% endif %}

{% if gate.show_measures %}
{% for m in view.measures %}
<section id="fo-{{ m.key }}" class="fo-card{% if m.superseded %} fo-superseded{% endif %}"><h3><span>{{ m.title }}</span><span><span class="risk {{ m.headline.css }}">{{ m.headline.text }}</span>{% if m.headline.label %} {{ m.headline.label }}{% endif %}{% if m.headline.heading %} <span class="subtle">· {{ m.headline.heading }}</span>{% endif %}</span></h3>
{% if m.superseded %}<p class="fo-gate"><strong>{{ m.superseded }}</strong></p>{% endif %}
{% if m.gc_note %}<p class="fo-gate watch">{{ m.gc_note }}</p>{% endif %}
{% if m.covenant_note %}<p class="fo-gate{% if 'breach' not in m.covenant_note %} watch{% endif %}">{{ m.covenant_note }}</p>{% endif %}
{% if m.deal_note %}<p class="fo-gate{% if not m.deal_unresolved %} watch{% elif m.deal_tag != 'Unresolved' %} continued{% endif %}">{% if m.deal_tag %}<span class="risk {{ 'very-high' if m.deal_tag == 'Unresolved' else ('moderate' if m.deal_tag == 'Overridden by analyst' else 'low') }}" style="font-weight:600">{{ m.deal_tag }}</span> {% endif %}{{ m.deal_note }}</p>{% endif %}
{% if m.prepaid_note %}<p class="fo-gate{% if not m.prepaid_tag %} watch{% elif m.prepaid_tag != 'Unresolved' %} continued{% endif %}">{% if m.prepaid_tag %}<span class="risk {{ 'very-high' if m.prepaid_tag == 'Unresolved' else ('moderate' if m.prepaid_tag == 'Overridden by analyst' else 'low') }}" style="font-weight:600">{{ m.prepaid_tag }}</span> {% endif %}{{ m.prepaid_note }}</p>{% endif %}
{% if m.trigger_note %}<p class="fo-gate{% if not m.trigger_tag %} watch{% elif m.trigger_tag != 'Escalated' %} continued{% endif %}">{% if m.trigger_tag %}<span class="risk {{ 'very-high' if m.trigger_tag == 'Escalated' else ('moderate' if m.trigger_tag == 'Overridden by analyst' else 'low') }}" style="font-weight:600">{{ m.trigger_tag }}</span> {% endif %}{{ m.trigger_note }} {% for key, name in ([('dscr_t2', 'T2'), ('dscr_t3', 'T3'), ('dscr_t1', 'T1')] if m.key == 'dscr' else [('icr_t2', 'ICR T2'), ('icr_t3', 'ICR T3'), ('icr_t1', 'ICR T1')] if m.key == 'icr' else [('leverage_t4', 'Debt/EBITDAR T4'), ('leverage_t1', 'Debt/EBITDAR T1'), ('leverage_t2', 'Debt/EBITDAR T2'), ('leverage_t3', 'Debt/EBITDAR T3')] if m.key == 'leverage' else [('rcf_t1', 'RCF/Debt T1'), ('rcf_t2', 'RCF/Debt T2'), ('rcf_t3', 'RCF/Debt T3'), ('rcf_t4', 'RCF/Debt T4')] if m.key == 'rcf' else [('margin_t1', 'EBITDAR Margin T1'), ('margin_t2', 'EBITDAR Margin T2')] if m.key == 'margin' else [('liquidity_t1', 'Liquidity T1'), ('liquidity_t2', 'Liquidity T2'), ('liquidity_t3', 'Liquidity T3')] if m.key == 'liquidity' else []) %}{% if view[key] and view[key].fired %}<a href="#fo-{{ key|replace('_', '-') }}">Trigger Agent result: {{ name }}</a> {% endif %}{% endfor %}</p>{% endif %}
{% for f in m.flag_notes %}<p class="fo-gate watch"><span class="warn">&#9888; {{ f }}</span> <a href="#fo-icr-t2">Trigger Agent result: ICR T2</a></p>{% endfor %}
{% if m.data_confidence_note %}<p class="fo-gate watch"><span class="warn">&#9888; {{ m.data_confidence_note }}</span> <a href="#fo-dscr-t3">Trigger Agent result: T3</a></p>{% endif %}
{% if m.override %}<p class="fo-gate continued"><strong>{{ m.override.text }}</strong> · counted in the composite: <span class="risk {{ m.override.score.css }}">{{ m.override.score.text }}</span></p>{% endif %}
{{ recomputations_of(m.key) }}
<p class="fo-formula">{{ m.formula }}</p>
{% if m.empty %}<p class="notice">{{ m.empty }}</p>{% else %}
<div class="table-wrap"><table><thead><tr><th>{{ m.unit }} millions</th>{% for h in m.headings %}<th class="num">{{ h }}</th>{% endfor %}</tr></thead><tbody>
{% for row in m.value_rows %}<tr><td>{{ row.label }}</td>{% for v in row.cells %}<td class="num">{{ v }}</td>{% endfor %}</tr>{% endfor %}
{% for row in m.result_rows %}<tr class="result"><td>{{ row.label }}</td>{% for v in row.cells %}<td class="num">{% if v.css %}<span class="risk {{ v.css }}">{{ v.text }}</span>{% else %}{{ v.text }}{% endif %}</td>{% endfor %}</tr>{% endfor %}
</tbody></table></div>
{% endif %}
{% for r in m.reasons %}<p class="subtle"><strong>{{ r.heading }}:</strong> {{ r.entries|join('; ') }}</p>{% endfor %}
{% for n in m.column_notes %}<p class="subtle"><strong>{{ n.heading }}:</strong> {{ n.entries|join('; ') }}</p>{% endfor %}
{% if m.benchmarks %}<p>Benchmark{% for b in m.benchmarks %} · {{ b.label }}: <strong>{{ b.text }}</strong>{% endfor %}</p><p class="subtle">{{ m.curve }}</p>{% endif %}
{% for b in m.bands %}<p class="subtle"><strong>{{ b.label }}:</strong> {{ b.text }}</p>{% endfor %}
<details><summary>Workings, sources and notes</summary>
{% if m.details %}<dl>{% for d in m.details %}<dt>{{ d.label }}</dt><dd>{{ d.text }}</dd>{% endfor %}</dl>{% endif %}
<div class="table-wrap"><table><thead><tr><th>Input</th><th>Source (concept used)</th></tr></thead><tbody>
{% for s in m.sources %}<tr><td>{{ s.label }}</td><td>{% if s.entries %}{{ s.entries|join('<br>'|safe) }}{% else %}<span class="subtle">not tagged</span>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
<p>{{ m.notes }}</p><p class="subtle">{{ m.gaps }}</p>
</details>
</section>
{% endfor %}
{% else %}
<section><p class="subtle">The measures were computed and are kept in the recorded payload (overview JSON), but are not shown: the analysis was stopped.</p></section>
{% endif %}

<script>
(function () {
  function reveal(id) {
    var el = id && document.getElementById(id);
    var box = el && (el.closest("details.fo-agent-box") || el.querySelector("details.fo-agent-box"));
    if (box && !box.open) { box.open = true; el.scrollIntoView(); }
  }
  document.addEventListener("click", function (e) {
    var a = e.target.closest && e.target.closest('a[href^="#"]');
    if (a) reveal(decodeURIComponent(a.hash.slice(1)));
    var b = e.target.closest && e.target.closest("[data-fo-agents]");
    if (b) document.querySelectorAll("details.fo-agent-box").forEach(function (d) { d.open = b.dataset.foAgents === "open"; });
  });
  window.addEventListener("hashchange", function () { reveal(decodeURIComponent(location.hash.slice(1))); });
  reveal(decodeURIComponent(location.hash.slice(1)));
})();
</script>
