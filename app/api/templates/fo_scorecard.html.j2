{% for o in cv.outcomes %}<tr{% if o.current %} style="background:#eef3f8;font-weight:600"{% endif %}><td>({{ o.letter }})</td><td>{{ o.when }}</td><td>{{ o.effect }}</td></tr>{% endfor %}
</tbody></table></div>
{% if cv.passages %}<ul>{% for p in cv.passages %}<li><code>{{ p.passage_id }}</code> <span class="subtle">{{ 'F-pages' if p.item == 'F' else ('Item ' ~ p.item if p.item else 'document') }} · {{ p.section_label }}{% if p.also_in %} (also in {{ p.also_in|join(', ') }}){% endif %} · hits: {{ p.hits|join(', ') }}</span> {{ p.text }}</li>{% endfor %}</ul>{% else %}<p class="subtle">No paragraph hit the search.</p>{% endif %}
{% if cv.rules.findings %}<h4>Keyword rules</h4><ul>{% for f in cv.rules.findings %}<li><code>{{ f.passage_id }}</code> {{ f.classification|replace('_', ' ') }}{% if f.waiver_months is not none %} ({{ '%.0f'|format(f.waiver_months) }} months){% endif %}: <span class="subtle">{{ f.quote }}</span></li>{% endfor %}</ul>{% endif %}
