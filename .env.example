# Example environment configuration for the AI-Assisted Credit Memo Generator.
#
# Copy this file to `.env` and fill in real values locally. The `.env` file is
# NEVER committed. Secrets are read from the environment only and are never
# hardcoded or logged (Requirement 25.2). The values below are placeholders
# only — do NOT put real secrets in this file.

# --- Application ---
APP_NAME=credit-memo-poc
ENVIRONMENT=development
DEBUG=false

# --- Persistence (SQLite for the PoC; migratable to PostgreSQL) ---
DATABASE_URL=sqlite:///./data/credit_memo.db

# --- File store layout ---
DATA_DIR=data
OUTPUT_DIR=output

# --- LLM provider (secrets read from env only) ---
# Supported: none, openai (Responses), openai_compatible (Chat Completions).
LLM_PROVIDER=none
# Set the exact model supported by your provider; no default model is selected.
LLM_MODEL=
# API key placeholder — replace locally; never commit a real key.
LLM_API_KEY=changeme-placeholder
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=12000
LLM_MAX_INPUT_BYTES=1500000
# For a local compatible model, set its HTTP localhost /v1 URL. A key is optional
# for openai_compatible. Oversized inputs fail rather than dropping evidence.
#
# To run the FIRST live Module 1 evaluation (Stages 1-3 only), set
# LLM_PROVIDER=openai, LLM_MODEL=<a model you have API access to>, and
# LLM_API_KEY=<your API key with available credits>, then run:
#   python -m app.demo --mode live --acknowledge-costs \
#       --fixture nvda-2026 --output output/module1-live
# A ChatGPT subscription does NOT provide API access or credits. Offline mode
# (the default) never reads a key and never calls a provider.

# --- SEC public acquisition (contact identification, not an API key) ---
SEC_USER_AGENT=Your Name your.email@example.com
