# Example environment configuration for the AI-Assisted Credit Memo Generator.
#
# Copy this file to `.env` and fill in real values locally. The `.env` file is
# NEVER committed. Secrets are read from the environment only and are never
# hardcoded or logged (Requirement 25.2). The values below are placeholders
# only — do NOT put real secrets in this file.

# --- Application ---
APP_NAME=credit-memo-poc
ENVIRONMENT=development
DEBUG=false

# --- Persistence (SQLite for the PoC; migratable to PostgreSQL) ---
DATABASE_URL=sqlite:///./data/credit_memo.db

# --- File store layout ---
DATA_DIR=data
OUTPUT_DIR=output

# --- LLM provider (secrets read from env only) ---
# Supported: none, vertex (ADC), openai, openai_compatible.
LLM_PROVIDER=vertex
# Set the exact model supported by your provider; no default model is selected.
LLM_MODEL=
# Unused for Vertex ADC; keep keys empty in the example.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=35000
LLM_MAX_INPUT_BYTES=1500000
# For a local compatible model, set its HTTP localhost /v1 URL. A key is optional
# for openai_compatible. Oversized inputs fail rather than dropping evidence.

# --- SEC public acquisition (contact identification, not an API key) ---
SEC_USER_AGENT=Your Name your.email@example.com

# --- Agentic analysis executor (Milestone 5) ---
AGENT_MAX_CONCURRENCY=6
AGENT_TIMEOUT_SECONDS=120
MAX_CHALLENGE_RERUN_ROUNDS=1

# --- Vertex AI provider (Milestone 18) ---
# Opt-in live Google Vertex AI Gemini. Credentials come from Application Default
# Credentials / a service account (gcloud auth application-default login, or
# GOOGLE_APPLICATION_CREDENTIALS pointing at a key file). NEVER commit a key.
# Install the optional SDK: pip install google-genai
# LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Alternative to ADC: a Vertex API key. When set, it is used instead of
# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION. Put it in `.env` only.
VERTEX_API_KEY=
# Model names are configuration, not hard-coded. Set the models your project has
# access to; tiers route cheap/fast narrow agents vs stronger orchestrators.
# Availability depends on the key's project and region, so probe before choosing.
# The narrow model below is explicitly selected; no silent substitution.
VERTEX_MODEL_NARROW=gemini-3.5-flash-lite
VERTEX_MODEL_ORCHESTRATOR=
VERTEX_MODEL_CHALLENGE=
# Optional sampling experiment; unset preserves existing sampling except Gemini 3 defaults to 1.0.
# LLM_TEMPERATURE=1.0
# For custom/OpenAI models, declare verified model capability before an override.
# LLM_TEMPERATURE_SUPPORTED=true
# LLM_TEMPERATURE_MAX=2

# User-supplied USD per million tokens for estimates; not verified list prices.
LLM_PRICES={"gemini-3.5-flash-lite": {"input": 0.3, "output": 2.5}, "gemini-3.5-flash": {"input": 1.5, "output": 9.0}, "gemini-3.8-flash": {"input": 0.75, "output": 3.75}, "gemini-3.7-flash": {"input": 0.75, "output": 3.75}, "gemini-3.6-flash": {"input": 0.75, "output": 3.75}, "gemini-3.1-flash-lite": {"input": 0.25, "output": 1.5}, "gemini-3.1-pro-preview": {"input": 2.0, "output": 12.0}, "gemini-2.5-pro": {"input": 1.25, "output": 10.0}, "gemini-2.5-flash": {"input": 0.3, "output": 2.5}, "gemini-2.5-flash-lite": {"input": 0.1, "output": 0.4}}
