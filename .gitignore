# Environment / secrets — never commit real secrets (Req 25.2)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-verify/
.venv*/
.python/
.uv-cache/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data / outputs (keep tracked directory placeholders)
data/**
!data/
!data/**/
!data/**/.gitkeep
output/**
!output/
!output/**/
!output/**/.gitkeep
*.db
*.sqlite3
# SQLite companions can also contain private M3 evidence/response pages.
*.db-journal
*.db-wal
*.db-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Benchmark reference workbook and its generated artifacts are kept local
# (not published); see examples/healthcare/README.md.
examples/healthcare/reference/*
!examples/healthcare/reference/.gitkeep

# Financial Overview input filings (large; one folder per 10-K), keep the README
edgar_filings/*
!edgar_filings/README.md
.bo_fixture/
explorer_evidence/

# Local desktop clutter and accidentally nested SDK installations.
.DS_Store
google-cloud-sdk/
/exec -l /

# The explicitly simulated, non-sensitive source fixture is needed offline.
!data/test_inputs/hca_simulated_corporate_structure.json

# Case-specific live exports and local investigation notes stay private/local.
examples/bo_m3/live_verification/
